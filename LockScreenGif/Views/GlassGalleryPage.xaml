<Page
    x:Class="LockscreenGif.Views.GlassGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,48">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Gallery Header -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Liquid Glass Gallery" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                    <Border Style="{StaticResource GlassPillStyle}" VerticalAlignment="Center">
                        <TextBlock Text="DEBUG PREVIEW" FontSize="11" FontWeight="Bold"
                                   Foreground="{ThemeResource GlassAccentBrassBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Foundation test bed for translucent layered surfaces, specular rim highlights, and solid fallbacks."
                           FontSize="14" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
            </StackPanel>

            <!-- Interactive Toolbar: Live Fallback & Theme Switcher -->
            <Border Style="{StaticResource GlassCardElevatedStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="FallbackToggle" Header="Simulate Solid Fallback"
                                      OffContent="Glass Active" OnContent="Fallback Forced"
                                      Toggled="FallbackToggle_Toggled" />
                        <Border Width="1" Background="{ThemeResource GlassBorderRimBrush}" Margin="8,4" />
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Active Fallback State" FontSize="11" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <TextBlock x:Name="FallbackStatusText" Text="Translucent Glass (Active)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassStatusSuccessBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Dark" Click="ThemeDark_Click" Style="{StaticResource GlassButtonStyle}" />
                        <Button Content="Light" Click="ThemeLight_Click" Style="{StaticResource GlassButtonStyle}" />
                        <Button Content="System" Click="ThemeDefault_Click" Style="{StaticResource GlassButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cards & Surfaces -->
            <StackPanel Spacing="12">
                <TextBlock Text="Surfaces &amp; Cards" FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                <Grid ColumnDefinitions="*,*">
                    <!-- Base Glass Card -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="Base Surface" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <Border Style="{StaticResource GlassPillStyle}" Margin="12,0,0,0">
                                    <TextBlock Text="Level 1" FontSize="11" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Primary translucent card with 1px diagonal specular rim gradient (#38FFFFFF -> #0AFFFFFF). Soft refractive layered depth."
                                       TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <Button Content="Action Inside Glass" Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Elevated Glass Card -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource GlassCardElevatedStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Elevated Surface" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <Border Style="{StaticResource GlassPillStyle}" Margin="12,0,0,0">
                                    <TextBlock Text="Level 2" FontSize="11" Foreground="{ThemeResource GlassAccentBrassBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="High-emphasis surface for modals, priority panels, and floating playback controls with deeper opacity."
                                       TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <Button Content="Primary Accent" Style="{StaticResource GlassPrimaryButtonStyle}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Buttons & Controls -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Buttons &amp; Interactive Controls" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />

                    <!-- Buttons Row -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Primary Action" Style="{StaticResource GlassPrimaryButtonStyle}" />
                        <Button Content="Glass Button" Style="{StaticResource GlassButtonStyle}" />
                        <Button Content="Subtle Button" Style="{StaticResource GlassSubtleButtonStyle}" />
                        <Button Content="Disabled Button" IsEnabled="False" Style="{StaticResource GlassButtonStyle}" />
                    </StackPanel>

                    <!-- Inputs & Dropdowns Row -->
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="6">
                            <TextBlock Text="Text Input" FontSize="12" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <TextBox PlaceholderText="Enter value..." Text="Lockscreen.gif" Style="{StaticResource GlassTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0" Spacing="6">
                            <TextBlock Text="Combo Dropdown" FontSize="12" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <ComboBox SelectedIndex="1" HorizontalAlignment="Stretch" Style="{StaticResource GlassComboBoxStyle}">
                                <ComboBoxItem Content="30 FPS (Smooth)" />
                                <ComboBoxItem Content="24 FPS (Cinematic)" />
                                <ComboBoxItem Content="15 FPS (Compact)" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0" Spacing="6">
                            <TextBlock Text="Toggle Control" FontSize="12" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <ToggleSwitch IsOn="True" OnContent="Enabled" OffContent="Disabled" Style="{StaticResource GlassToggleSwitchStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Slider & Progress -->
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Quality &amp; Encoding Slider" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="85% (High)" Style="{StaticResource GlassReadoutTextStyle}" />
                        </Grid>
                        <Slider Value="85" Minimum="10" Maximum="100" Style="{StaticResource GlassSliderStyle}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Text="Progress Indication" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="65%" Style="{StaticResource GlassReadoutTextStyle}" />
                        </Grid>
                        <ProgressBar Value="65" Maximum="100" Style="{StaticResource GlassProgressBarStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Telemetry & Monospace Readouts -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Monospace Telemetry Readouts (No Hallucinated Data)" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Border Grid.Column="0" Style="{StaticResource GlassPillStyle}" Margin="0,0,6,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="DURATION" FontSize="10" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="00:10.25" Style="{StaticResource GlassReadoutTextStyle}" FontSize="15" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource GlassPillStyle}" Margin="3,0,3,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="FRAME COUNT" FontSize="10" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="246 FRAMES" Style="{StaticResource GlassReadoutTextStyle}" FontSize="15" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource GlassPillStyle}" Margin="3,0,3,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="FPS RATE" FontSize="10" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="24.00 FPS" Style="{StaticResource GlassReadoutTextStyle}" FontSize="15" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource GlassPillStyle}" Margin="6,0,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ESTIMATED SIZE" FontSize="10" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="18.42 MB" Style="{StaticResource GlassReadoutTextStyle}" FontSize="15" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

