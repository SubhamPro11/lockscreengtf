<Page
    x:Class="LockscreenGif.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:LockscreenGif.Helpers"
    xmlns:local="using:LockscreenGif.Views"
    KeyDown="ShellPage_KeyDown"
    UseLayoutRounding="True">

    <Grid Background="{ThemeResource GlassBaseBrush}">
        <!-- 1. Ambient Background Layer (drifting dominant color fields behind the page) -->
        <Grid x:Name="AmbientRootGrid" Background="{ThemeResource GlassBaseBrush}" IsHitTestVisible="False">
            <!-- Dynamic Drifting Ambient Color Fields -->
            <Canvas x:Name="AmbientCanvas" Opacity="0.8" IsHitTestVisible="False">
                <!-- Blob 1 (Primary Dominant / Material 3 Coral #FFA79B) -->
                <Ellipse x:Name="Blob1" Width="720" Height="580" Margin="-100,-80,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop x:Name="Blob1Stop0" Color="#12FFA79B" Offset="0.0" />
                            <GradientStop x:Name="Blob1Stop1" Color="#08FFA79B" Offset="0.5" />
                            <GradientStop Color="#00FFA79B" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob1Transform" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Blob 2 (Secondary Dominant / Material 3 Warm Bronze #5D3F3B) -->
                <Ellipse x:Name="Blob2" Width="820" Height="680" Margin="200,120,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop x:Name="Blob2Stop0" Color="#185D3F3B" Offset="0.0" />
                            <GradientStop x:Name="Blob2Stop1" Color="#085D3F3B" Offset="0.55" />
                            <GradientStop Color="#005D3F3B" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob2Transform" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Subtle Top Vignette Layer to keep Title Bar text razor sharp -->
            <Border Height="80" VerticalAlignment="Top" IsHitTestVisible="False"
                    Background="{ThemeResource GlassTopVignetteBrush}" />
        </Grid>

        <!-- 2. Figma Custom Title Bar: Brand + Floating Glass Navigation Capsule + Draggable Client Space -->
        <Grid x:Name="ShellRootGrid">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideTitleBarState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="CompactTitleBarState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BrandTitleText.Visibility" Value="Collapsed" />
                            <Setter Target="TitleBarGrid.ColumnSpacing" Value="12" />
                            <Setter Target="TitleBarGrid.Padding" Value="12,0,0,0" />
                            <Setter Target="LockscreenNavButton.Padding" Value="10,0" />
                            <Setter Target="WallpaperNavButton.Padding" Value="10,0" />
                            <Setter Target="DiagnosticsNavButton.Padding" Value="10,0" />
                            <Setter Target="SettingsNavButton.Padding" Value="10,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid" Grid.Row="0" Padding="20,0,0,0" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Mark -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind helpers:BuildInfo.BuildStamp, Mode=OneTime}">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="8"
                            Background="{ThemeResource GlassPrimaryBrush}">
                        <FontIcon Glyph="&#xE72E;"
                                  FontSize="12"
                                  Foreground="{ThemeResource GlassOnPrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="BrandTitleText"
                               Text="LockscreenGif"
                               FontFamily="{StaticResource GlassFontUi}"
                               FontWeight="Medium"
                               FontSize="13"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Floating Glass Navigation Capsule -->
                <Border Grid.Column="1"
                        Height="40"
                        Padding="4"
                        CornerRadius="999"
                        VerticalAlignment="Center"
                        Background="{ThemeResource GlassTrayFillBrush}"
                        BorderBrush="{ThemeResource GlassTrayBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="LockscreenNavButton"
                                Click="NavTab_Click"
                                Tag="Lockscreen"
                                Height="30"
                                Padding="14,0"
                                CornerRadius="999"
                                BorderThickness="0"
                                Style="{StaticResource MaterialTextButtonStyle}"
                                AutomationProperties.Name="Lockscreen tab">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="LockscreenNavIcon" Glyph="&#xE72E;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="LockscreenNavText" Text="Lockscreen" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WallpaperNavButton"
                                Click="NavTab_Click"
                                Tag="Wallpaper"
                                Height="30"
                                Padding="14,0"
                                CornerRadius="999"
                                BorderThickness="0"
                                Style="{StaticResource MaterialTextButtonStyle}"
                                AutomationProperties.Name="Desktop Wallpaper tab">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="WallpaperNavIcon" Glyph="&#xE7F8;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="WallpaperNavText" Text="Desktop wallpaper" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DiagnosticsNavButton"
                                Click="NavTab_Click"
                                Tag="Diagnostics"
                                Height="30"
                                Padding="14,0"
                                CornerRadius="999"
                                BorderThickness="0"
                                Style="{StaticResource MaterialTextButtonStyle}"
                                AutomationProperties.Name="Diagnostics tab">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="DiagnosticsNavIcon" Glyph="&#xE9D9;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="DiagnosticsNavText" Text="Diagnostics" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton"
                                Click="NavTab_Click"
                                Tag="Settings"
                                Height="30"
                                Padding="14,0"
                                CornerRadius="999"
                                BorderThickness="0"
                                Style="{StaticResource MaterialTextButtonStyle}"
                                AutomationProperties.Name="Settings tab">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="SettingsNavIcon" Glyph="&#xE713;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsNavText" Text="Settings" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Draggable Client Space between Capsule and Caption Buttons -->
                <Grid Grid.Column="2" x:Name="AppTitleBar" Background="Transparent" MinWidth="48" HorizontalAlignment="Stretch" Height="48" />

                <!-- Reserved space for Windows system caption buttons (minimize, maximize, close) -->
                <Grid Grid.Column="3" x:Name="CaptionButtonSpacer" Width="140" Height="48" Background="Transparent" />
            </Grid>

            <!-- Content Area: InfoBars and Content Frame -->
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <!-- Analytics Notification -->
                    <RowDefinition Height="Auto" />
                    <!-- Lockscreen Verification Status -->
                    <RowDefinition Height="Auto" />
                    <!-- Page Content Frame -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Analytics Notification InfoBar -->
                <InfoBar Grid.Row="0"
                         x:Name="AnalyticsNotice"
                         Margin="16,8,16,8"
                         IsOpen="False"
                         Severity="Informational"
                         Title="Usage analytics are enabled"
                         Message="LockscreenGif shares feature use and operation outcomes with PostHog in the EU to help improve the app. You can opt out in Settings > Analytics. Filenames, media, and diagnostic logs are never included.">
                    <InfoBar.ActionButton>
                        <Button Content="Open settings" Click="OpenAnalyticsSettings_Click" Style="{StaticResource GlassButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Lockscreen Verification Status InfoBar -->
                <InfoBar Grid.Row="1"
                         x:Name="LockscreenVerificationStatus"
                         Margin="16,0,16,8"
                         IsOpen="False"
                         Severity="Informational" />

                <!-- Content Frame -->
                <Frame Grid.Row="2" x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
            </Grid>
        </Grid>
    </Grid>
</Page>
