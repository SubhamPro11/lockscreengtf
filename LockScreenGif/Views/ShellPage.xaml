<Page
    x:Class="LockscreenGif.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LockscreenGif.Views"
    KeyDown="ShellPage_KeyDown"
    UseLayoutRounding="True">

    <Grid Background="Transparent">
        <!-- 1. Ambient Background Layer (drifting dominant color fields behind the page) -->
        <Grid x:Name="AmbientRootGrid" Background="{ThemeResource GlassBaseBrush}" IsHitTestVisible="False">
            <!-- Dynamic Drifting Ambient Color Fields -->
            <Canvas x:Name="AmbientCanvas" Opacity="0.8" IsHitTestVisible="False">
                <!-- Blob 1 (Primary Dominant / Material 3 Coral #FFA79B) -->
                <Ellipse x:Name="Blob1" Width="720" Height="580" Margin="-100,-80,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop x:Name="Blob1Stop0" Color="#12FFA79B" Offset="0.0" />
                            <GradientStop x:Name="Blob1Stop1" Color="#08FFA79B" Offset="0.5" />
                            <GradientStop Color="#00FFA79B" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob1Transform" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Blob 2 (Secondary Dominant / Material 3 Warm Bronze #5D3F3B) -->
                <Ellipse x:Name="Blob2" Width="820" Height="680" Margin="200,120,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop x:Name="Blob2Stop0" Color="#185D3F3B" Offset="0.0" />
                            <GradientStop x:Name="Blob2Stop1" Color="#085D3F3B" Offset="0.55" />
                            <GradientStop Color="#005D3F3B" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob2Transform" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Subtle Top Vignette Layer to keep Title Bar text razor sharp -->
            <Border Height="80" VerticalAlignment="Top" IsHitTestVisible="False"
                    Background="{ThemeResource GlassTopVignetteBrush}" />
        </Grid>

        <!-- 2. Windows 11 Unified Top Navigation & Custom Title Bar (Height ~46px, single row) -->
        <NavigationView x:Name="Navigation"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewTopPaneHeight">46</x:Double>
                <Thickness x:Key="NavigationViewTopPaneMargin">0,0,0,0</Thickness>
                <Thickness x:Key="NavigationViewHeaderMargin">0,0,0,0</Thickness>
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,14,0" VerticalAlignment="Center" Height="46">
                    <Image Source="ms-appx:///Assets/WindowIcon.png" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="LockscreenGif"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.PaneCustomContent>
                <!-- Draggable Client Space between Tabs and Caption Buttons -->
                <Grid x:Name="AppTitleBar" Background="Transparent" MinWidth="48" HorizontalAlignment="Stretch" Height="46" />
            </NavigationView.PaneCustomContent>

            <NavigationView.PaneFooter>
                <!-- Reserved space for Windows system caption buttons (minimize, maximize, close) -->
                <Grid x:Name="CaptionButtonSpacer" Width="140" Height="46" Background="Transparent" />
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LockscreenItem" Content="Lockscreen" Tag="Lockscreen"
                                    AutomationProperties.Name="Lockscreen tab">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WallpaperItem" Content="Desktop Wallpaper" Tag="Wallpaper"
                                    AutomationProperties.Name="Desktop Wallpaper tab">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DiagnosticsItem" Content="Diagnostics" Tag="Diagnostics"
                                    AutomationProperties.Name="Diagnostics tab">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="Settings"
                                    AutomationProperties.Name="Settings tab">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Content Area: InfoBars and Content Frame -->
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <!-- Analytics Notification -->
                    <RowDefinition Height="Auto" />
                    <!-- Lockscreen Verification Status -->
                    <RowDefinition Height="Auto" />
                    <!-- Page Content Frame -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Analytics Notification InfoBar -->
                <InfoBar Grid.Row="0"
                         x:Name="AnalyticsNotice"
                         Margin="16,8,16,8"
                         IsOpen="False"
                         Severity="Informational"
                         Title="Usage analytics are enabled"
                         Message="LockscreenGif shares feature use and operation outcomes with PostHog in the EU to help improve the app. You can opt out in Settings > Analytics. Filenames, media, and diagnostic logs are never included.">
                    <InfoBar.ActionButton>
                        <Button Content="Open settings" Click="OpenAnalyticsSettings_Click" Style="{StaticResource GlassButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Lockscreen Verification Status InfoBar -->
                <InfoBar Grid.Row="1"
                         x:Name="LockscreenVerificationStatus"
                         Margin="16,0,16,8"
                         IsOpen="False"
                         Severity="Informational" />

                <!-- Content Frame -->
                <Frame Grid.Row="2" x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
