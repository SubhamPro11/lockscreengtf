<Page
    x:Class="LockscreenGif.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LockscreenGif.ViewModels"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style x:Key="DiagnosticCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <DataTemplate x:Key="FindingHeaderTemplate" x:DataType="vm:DiagnosticFindingViewModel">
            <Border Style="{StaticResource InstrumentCardStyle}" Padding="14,10" Margin="0,3,0,6">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                        <FontIcon FontSize="18" Glyph="&#xE73E;" Foreground="{ThemeResource InstrumentGaugeGreenBrush}"
                                  Visibility="{x:Bind SuccessVisibility}" AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                        <FontIcon FontSize="18" Glyph="&#xE7BA;" Foreground="{ThemeResource InstrumentAlertRedBrush}"
                                  Visibility="{x:Bind WarningVisibility}" AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                        <FontIcon FontSize="18" Glyph="&#xE946;" Foreground="{ThemeResource InstrumentAccentBrassBrush}"
                                  Visibility="{x:Bind InformationVisibility}" AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource InstrumentTextMutedBrush}"
                                   Text="{x:Bind StatusDescription}" FontFamily="{StaticResource InstrumentMonoFont}" />
                    </StackPanel>

                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="6,2"
                            Background="{ThemeResource InstrumentBorderBrush}">
                        <TextBlock Text="{x:Bind BadgeText}" FontFamily="{StaticResource InstrumentMonoFont}"
                                   FontSize="10" FontWeight="Bold" Foreground="{ThemeResource InstrumentTextPrimaryBrush}" />
                    </Border>

                    <!-- Plain Language Summary -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="28,2,0,0"
                               Text="{x:Bind SummaryText}" TextWrapping="Wrap" FontSize="12" />

                    <!-- Collapsible Raw Detail ("one click deeper") -->
                    <Expander Grid.Row="2" Grid.ColumnSpan="3" Margin="28,4,0,0"
                              Header="Technical details" Visibility="{x:Bind TechnicalDetailVisibility}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock Text="{x:Bind TechnicalDetail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="{StaticResource InstrumentMonoFont}" FontSize="11"
                                   Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                    </Expander>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="920" Margin="24,20,24,16" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Diagnostics" />
                    <TextBlock FontSize="16" Text="Find out what happens when your screen locks" TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Apply a GIF, lock your computer, then unlock to review the findings. Results stay in memory until you start another test or close the app. Export a report if you want to keep it."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource DiagnosticCard}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Set up your test" />
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Source animation" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SourceDescription, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <HyperlinkButton HorizontalAlignment="Left" Padding="0" Click="ChooseSource_Click"
                                         Content="Choose or convert a GIF on Lockscreen"
                                         AutomationProperties.Name="Select source animation on Lockscreen page"
                                         IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" />
                        <CheckBox
                            Content="Use the bundled reference animation"
                            IsChecked="{x:Bind ViewModel.UseReference, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="6">
                            <ToggleSwitch
                                AutomationProperties.Name="Set the lock screen through Windows before applying the GIF"
                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.Preferences.UseWindowsApi, Mode=TwoWay}"
                                OffContent="Windows API step off"
                                OnContent="Windows API step on">
                                <ToggleSwitch.Header>
                                    <TextBlock Text="Set the lock screen through Windows first" TextWrapping="Wrap" />
                                </ToggleSwitch.Header>
                            </ToggleSwitch>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="If your GIF is not working, turning this on may help. Windows will set the lock-screen image before the app applies the GIF. This preference is shared with Settings, also applies to normal lockscreen applies, and is saved between restarts."
                                TextWrapping="Wrap" />
                            <InfoBar IsOpen="{x:Bind ViewModel.Preferences.HasSaveError, Mode=OneWay}"
                                IsClosable="False" Severity="Warning" Title="Could not save the lockscreen preference"
                                Message="The setting applies for this session, but could not be saved. Toggle it again to retry before closing the app." />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SetupWarningsVisibility, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SetupWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagnosticSetupWarning">
                                        <InfoBar
                                            Margin="0,0,0,8"
                                            Title="{x:Bind Title}"
                                            IsClosable="False"
                                            IsOpen="True"
                                            Message="{x:Bind Message}"
                                            Severity="Warning" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Check setup problems again"
                                Click="Refresh_Click"
                                Content="Check again"
                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Starting a test may request administrator permission once for tracing and any necessary cache access. Keep this app open throughout the test."
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="Start_Click"
                            Content="Start test and apply"
                            AutomationProperties.Name="Start diagnostic test and apply animation"
                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DiagnosticCard}" Visibility="{x:Bind ViewModel.SessionVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Phase, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SessionDescription, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressDescription, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}">
                            <Button Click="Lock_Click" Content="Lock now" AutomationProperties.Name="Lock computer now for testing" IsEnabled="{x:Bind ViewModel.CanLock, Mode=OneWay}" />
                            <Button Click="Stop_Click" Content="Stop test" AutomationProperties.Name="Stop active diagnostic test" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DiagnosticCard}" Visibility="{x:Bind ViewModel.ResultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Findings" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticFindingViewModel">
                                <Grid Margin="0,0,0,8">
                                    <ContentPresenter
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource FindingHeaderTemplate}"
                                        Visibility="{x:Bind LeafVisibility}" />
                                    <Expander
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Header="{Binding}"
                                        HeaderTemplate="{StaticResource FindingHeaderTemplate}"
                                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                        Visibility="{x:Bind GroupVisibility}">
                                        <ItemsControl
                                            ItemsSource="{x:Bind Children}"
                                            ItemTemplate="{StaticResource FindingHeaderTemplate}" />
                                    </Expander>
                                </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <Border
            Grid.Row="1"
            MaxWidth="920"
            Margin="24,0,24,16"
            Padding="18,16"
            Style="{StaticResource InstrumentCardStyle}">
            <StackPanel Spacing="12">
                <InfoBar
                    Title="Diagnostics"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Informational"
                    AutomationProperties.LiveSetting="Polite" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="EXPORT SANITIZED DIAGNOSTIC REPORT"
                                   FontFamily="{StaticResource InstrumentMonoFont}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                        <TextBlock Text="Generates an inspectable .zip archive for troubleshooting lock-screen issues."
                                   FontSize="12" Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontSize="11" FontFamily="{StaticResource InstrumentMonoFont}"
                               Foreground="{ThemeResource InstrumentTextMutedBrush}" VerticalAlignment="Center"
                               Text="{x:Bind AppVersion}" />
                </Grid>

                <Grid ColumnSpacing="16" Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource InstrumentCardStyle}" Padding="12,8" Background="{ThemeResource InstrumentBackgroundBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="✓ INCLUDED IN REPORT" FontFamily="{StaticResource InstrumentMonoFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="{ThemeResource InstrumentGaugeGreenBrush}" />
                            <TextBlock Text="• Windows build, edition, and feature ID configuration" FontSize="11" Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                            <TextBlock Text="• Lock-screen cache verification timestamps and hashes" FontSize="11" Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                            <TextBlock Text="• Recent application event logs (usernames and local paths redacted)" FontSize="11" Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource InstrumentCardStyle}" Padding="12,8" Background="{ThemeResource InstrumentBackgroundBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="✗ EXCLUDED FOR PRIVACY" FontFamily="{StaticResource InstrumentMonoFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="{ThemeResource InstrumentAccentBrassBrush}" />
                            <TextBlock Text="• No source videos or user GIFs included" FontSize="11" Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                            <TextBlock Text="• No screen captures or lock-screen images" FontSize="11" Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                            <TextBlock Text="• No passwords, tokens, or memory dumps" FontSize="11" Foreground="{ThemeResource InstrumentTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Button
                    HorizontalAlignment="Stretch"
                    Click="Export_Click"
                    Content="Export Sanitized Report (ZIP)…"
                    IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="14,10"
                    AutomationProperties.Name="Export sanitized diagnostic report as ZIP"
                    ToolTipService.ToolTip="Save a sanitized ZIP archive containing summary.md, session.json, events.jsonl, and redacted logs." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
