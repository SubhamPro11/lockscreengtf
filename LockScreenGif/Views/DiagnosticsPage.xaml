<Page
    x:Class="LockscreenGif.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LockscreenGif.ViewModels"
    NavigationCacheMode="Required"
    UseLayoutRounding="True">

    <Page.Resources>
        <!-- Finding Item Template -->
        <DataTemplate x:Key="FindingHeaderTemplate" x:DataType="vm:DiagnosticFindingViewModel">
            <Border Background="{ThemeResource GlassRaisedBrush}"
                    BorderBrush="{ThemeResource GlassHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource GlassRadiusControl}"
                    Padding="16,12"
                    Margin="0,2,0,4">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                        <FontIcon FontSize="18" Glyph="&#xE73E;" Foreground="{ThemeResource GlassStatusSuccessBrush}"
                                  Visibility="{x:Bind SuccessVisibility}" AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                        <FontIcon FontSize="18" Glyph="&#xE7BA;" Foreground="{ThemeResource GlassStatusAlertBrush}"
                                  Visibility="{x:Bind WarningVisibility}" AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                        <FontIcon FontSize="18" Glyph="&#xE946;" Foreground="{ThemeResource GlassEmberHoverBrush}"
                                  Visibility="{x:Bind InformationVisibility}" AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="13"
                                   FontFamily="{StaticResource GlassFontUi}"
                                   Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   Text="{x:Bind StatusDescription}" FontFamily="{StaticResource GlassFontMonospace}" />
                    </StackPanel>

                    <!-- Status Badge -->
                    <Border Grid.Column="2" VerticalAlignment="Center"
                            Background="{ThemeResource GlassRaisedBrush}"
                            BorderBrush="{ThemeResource GlassHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource GlassRadiusSmall}"
                            Padding="8,2">
                        <TextBlock Text="{x:Bind BadgeText}" FontFamily="{StaticResource GlassFontMonospace}"
                                   FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                    </Border>

                    <!-- Plain Language Summary -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="30,2,0,0"
                               FontFamily="{StaticResource GlassFontUi}"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}"
                               Text="{x:Bind SummaryText}" TextWrapping="Wrap" FontSize="12" />

                    <!-- Collapsible Raw Detail ("one click deeper") -->
                    <Expander Grid.Row="2" Grid.ColumnSpan="3" Margin="30,4,0,0"
                              Header="Technical details" Visibility="{x:Bind TechnicalDetailVisibility}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock Text="{x:Bind TechnicalDetail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="{StaticResource GlassFontMonospace}" FontSize="11"
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                    </Expander>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1040"
                    Margin="28,20,28,80"
                    Spacing="24"
                    HorizontalAlignment="Stretch">

            <!-- 1. Page Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Diagnostics"
                           FontFamily="{StaticResource GlassFontDisplay}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                <TextBlock Text="Check what Windows does when your lock screen activates. Start a test, lock your PC, and unlock to inspect results."
                           FontFamily="{StaticResource GlassFontUi}"
                           FontSize="14"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 2. Test Setup Card (Flat Raised surface) -->
            <Border Background="{ThemeResource GlassRaisedBrush}"
                    BorderBrush="{ThemeResource GlassHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource GlassRadiusControl}"
                    Padding="20,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Set up your test"
                               FontFamily="{StaticResource GlassFontUi}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />

                    <!-- Source animation selection -->
                    <Grid ColumnSpacing="16" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Source animation"
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                       Text="{x:Bind ViewModel.SourceDescription, Mode=OneWay}"
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="12" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Click="ChooseSource_Click"
                                         Style="{StaticResource GlassHyperlinkButtonStyle}"
                                         AutomationProperties.Name="Select source animation on Lockscreen page"
                                         IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Change on Lockscreen page"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="13" />
                                <FontIcon Glyph="&#xE76C;" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>

                    <!-- Bundled reference animation checkbox (Clean padding, no clipping) -->
                    <CheckBox x:Name="BundledAnimationCheckBox"
                              IsChecked="{x:Bind ViewModel.UseReference, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                              Margin="0,4"
                              AutomationProperties.Name="Use the bundled reference animation">
                        <TextBlock Text="Use the bundled reference animation (simple loop)"
                                   FontFamily="{StaticResource GlassFontUi}"
                                   FontSize="13"
                                   Foreground="{ThemeResource GlassTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </CheckBox>

                    <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                    <!-- Windows API Step Row -->
                    <Grid ColumnSpacing="16" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Set lock screen through Windows first"
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                       Text="Windows sets the lock-screen image before the app applies the GIF. May help if Windows fails to detect changes."
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      AutomationProperties.Name="Set the lock screen through Windows before applying the GIF"
                                      IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.Preferences.UseWindowsApi, Mode=TwoWay}"
                                      Style="{StaticResource GlassToggleSwitchStyle}" />
                    </Grid>

                    <InfoBar IsOpen="{x:Bind ViewModel.Preferences.HasSaveError, Mode=OneWay}"
                             IsClosable="False" Severity="Warning" Title="Could not save preference"
                             Message="The setting applies for this session, but could not be saved to disk." />

                    <!-- Setup Warnings List -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SetupWarningsVisibility, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SetupWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticSetupWarning">
                                    <InfoBar Margin="0,0,0,8"
                                             Title="{x:Bind Title}"
                                             IsClosable="False"
                                             IsOpen="True"
                                             Message="{x:Bind Message}"
                                             Severity="Warning" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button HorizontalAlignment="Left"
                                AutomationProperties.Name="Check setup problems again"
                                Click="Refresh_Click"
                                Content="Check again"
                                Style="{StaticResource GlassButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Foreground="{ThemeResource GlassTextSecondaryBrush}"
                               Text="Starting a test may ask for administrator permission once to trace file operations. Keep this app open during the test."
                               FontFamily="{StaticResource GlassFontUi}"
                               TextWrapping="Wrap" FontSize="12" />

                    <!-- Start Action Button -->
                    <StackPanel Spacing="6">
                        <Grid ToolTipService.ToolTip="{x:Bind ViewModel.StartDisabledReason, Mode=OneWay}">
                            <Button HorizontalAlignment="Stretch"
                                    Click="Start_Click"
                                    Content="Run test and apply"
                                    AutomationProperties.Name="Start diagnostic test and apply animation"
                                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                    Style="{StaticResource MaterialFilledButtonLargeStyle}" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource GlassFontUi}"
                                   FontSize="12"
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   Text="{x:Bind ViewModel.StartDisabledReason, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StartDisabledVisibility, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Active Test Session Status (Obsidian Stage container) -->
            <Border Background="#0A0908"
                    BorderBrush="{ThemeResource GlassHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource GlassRadiusStage}"
                    Padding="24"
                    Visibility="{x:Bind ViewModel.SessionVisibility, Mode=OneWay}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="24" Height="24"
                                      Foreground="{ThemeResource GlassEmberBrush}"
                                      IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   FontFamily="{StaticResource GlassFontUi}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource GlassTextPrimaryBrush}"
                                   Text="{x:Bind ViewModel.Phase, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Foreground="{ThemeResource GlassTextSecondaryBrush}"
                               FontFamily="{StaticResource GlassFontUi}"
                               Text="{x:Bind ViewModel.SessionDescription, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="13" />
                    <TextBlock Foreground="{ThemeResource GlassTextPrimaryBrush}"
                               FontFamily="{StaticResource GlassFontMonospace}"
                               Text="{x:Bind ViewModel.ProgressDescription, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="12" />

                    <!-- Interactive Transport Controls -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}">
                        <Button Click="Lock_Click"
                                Content="Lock now"
                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                AutomationProperties.Name="Lock computer now for testing"
                                IsEnabled="{x:Bind ViewModel.CanLock, Mode=OneWay}" />
                        <Button Click="Stop_Click"
                                Content="Stop test"
                                Style="{StaticResource GlassButtonStyle}"
                                AutomationProperties.Name="Stop active diagnostic test"
                                IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Findings Results -->
            <Border Background="{ThemeResource GlassRaisedBrush}"
                    BorderBrush="{ThemeResource GlassHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource GlassRadiusControl}"
                    Padding="20,16"
                    Visibility="{x:Bind ViewModel.ResultVisibility, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Findings"
                               FontFamily="{StaticResource GlassFontUi}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiagnosticFindingViewModel">
                                <Grid Margin="0,0,0,6">
                                    <ContentPresenter Content="{Binding}"
                                                      ContentTemplate="{StaticResource FindingHeaderTemplate}"
                                                      Visibility="{x:Bind LeafVisibility}" />
                                    <Expander HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Header="{Binding}"
                                              HeaderTemplate="{StaticResource FindingHeaderTemplate}"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              Visibility="{x:Bind GroupVisibility}">
                                        <ItemsControl ItemsSource="{x:Bind Children}"
                                                      ItemTemplate="{StaticResource FindingHeaderTemplate}" />
                                    </Expander>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. Export Sanitized Report Section (Clean Flat Raised surface) -->
            <Border Background="{ThemeResource GlassRaisedBrush}"
                    BorderBrush="{ThemeResource GlassHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource GlassRadiusControl}"
                    Padding="20,16">
                <StackPanel Spacing="14">
                    <InfoBar Title="Diagnostics"
                             IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                             Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                             Severity="Informational"
                             AutomationProperties.LiveSetting="Polite" />

                    <!-- Header & Clean Version string -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Export diagnostic report"
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Creates an inspectable .zip archive for troubleshooting lock-screen issues."
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="12"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>
                        <!-- Clean display version without build suffix -->
                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   FontFamily="{StaticResource GlassFontMonospace}"
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind AppVersion}"
                                   ToolTipService.ToolTip="{x:Bind FullVersion}" />
                    </Grid>

                    <!-- Neutral Two-Column Report Contents (Clean informational columns, not green/red alert boxes) -->
                    <Grid ColumnSpacing="16" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Included in report -->
                        <Border Background="{ThemeResource GlassSubtleBrush}"
                                BorderBrush="{ThemeResource GlassHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource GlassRadiusControl}"
                                Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Included in report"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <TextBlock Text="• Windows build, edition, and feature ID"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="11"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="• Lock-screen cache verification timestamps and hashes"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="11"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="• Redacted application event logs"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="11"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Excluded for privacy -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource GlassSubtleBrush}"
                                BorderBrush="{ThemeResource GlassHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource GlassRadiusControl}"
                                Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Excluded for privacy"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <TextBlock Text="• No source videos or user GIFs included"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="11"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="• No screen captures or lock-screen images"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="11"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="• No passwords, tokens, or personal paths"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="11"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Export Action Button -->
                    <StackPanel Spacing="6">
                        <Grid ToolTipService.ToolTip="{x:Bind ViewModel.ExportDisabledReason, Mode=OneWay}">
                            <Button HorizontalAlignment="Stretch"
                                    Click="Export_Click"
                                    Content="Save report (.zip)..."
                                    IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                                    Style="{StaticResource MaterialTonalButtonStyle}"
                                    AutomationProperties.Name="Export sanitized diagnostic report as ZIP" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource GlassFontUi}"
                                   FontSize="12"
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   Text="{x:Bind ViewModel.ExportDisabledReason, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.ExportDisabledVisibility, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>