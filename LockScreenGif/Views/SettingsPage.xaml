<Page
    x:Class="LockscreenGif.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:LockscreenGif.Helpers"
    UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1040"
                    Margin="28,20,28,80"
                    Spacing="24"
                    HorizontalAlignment="Stretch">

            <!-- 1. Page Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Settings"
                           FontFamily="{StaticResource GlassFontDisplay}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                <TextBlock Text="Preferences, diagnostics, and system integration options."
                           FontFamily="{StaticResource GlassFontUi}"
                           FontSize="14"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
            </StackPanel>

            <!-- 2. Appearance & Theme Switcher -->
            <StackPanel Spacing="8">
                <TextBlock Text="APPEARANCE"
                           FontFamily="{StaticResource GlassFontMonospace}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />

                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource GlassRadiusControl}"
                        Padding="20,12">
                    <Grid ColumnSpacing="16" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="App theme"
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Select light, dark, or follow Windows system appearance."
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="12"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Rounded Pill Segmented Switcher -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource GlassSubtleBrush}"
                                BorderBrush="{ThemeResource GlassHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="ThemeLightButton"
                                        Click="ThemeOption_Click"
                                        Tag="Light"
                                        CornerRadius="999"
                                        Height="34"
                                        Padding="14,0"
                                        Style="{StaticResource MaterialTextButtonStyle}"
                                        AutomationProperties.Name="Switch to Light theme">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE706;" FontSize="13" />
                                        <TextBlock Text="Light" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ThemeDarkButton"
                                        Click="ThemeOption_Click"
                                        Tag="Dark"
                                        CornerRadius="999"
                                        Height="34"
                                        Padding="14,0"
                                        Style="{StaticResource MaterialTextButtonStyle}"
                                        AutomationProperties.Name="Switch to Dark theme">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE708;" FontSize="13" />
                                        <TextBlock Text="Dark" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ThemeDefaultButton"
                                        Click="ThemeOption_Click"
                                        Tag="Default"
                                        CornerRadius="999"
                                        Height="34"
                                        Padding="14,0"
                                        Style="{StaticResource MaterialTextButtonStyle}"
                                        AutomationProperties.Name="Use Windows system theme">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                                        <TextBlock Text="System" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. Lock Screen Behavior & System Integration -->
            <StackPanel Spacing="8">
                <TextBlock Text="LOCK SCREEN"
                           FontFamily="{StaticResource GlassFontMonospace}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />

                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource GlassRadiusControl}"
                        Padding="20,12">
                    <StackPanel Spacing="12">
                        <!-- Windows API Setting Row (48px) -->
                        <Grid ColumnSpacing="16" MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Set lock screen through Windows API"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <TextBlock Text="Asks Windows to apply an image before LockscreenGif writes animation files, helping Windows detect file changes."
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="12"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WindowsApiToggle"
                                          Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource GlassToggleSwitchStyle}"
                                          IsOn="{x:Bind ViewModel.Preferences.UseWindowsApi, Mode=TwoWay}"
                                          AutomationProperties.Name="Set lock screen through Windows API" />
                        </Grid>

                        <InfoBar IsOpen="{x:Bind ViewModel.Preferences.HasSaveError, Mode=OneWay}"
                                 IsClosable="False" Severity="Warning" Title="Could not save preference"
                                 Message="The setting applies for this session, but could not be saved to disk." />

                        <!-- Hairline Divider -->
                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                        <!-- Lock-screen Feature ID Row (48px) -->
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="16" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Lock-screen feature ID"
                                               FontFamily="{StaticResource GlassFontUi}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                    <TextBlock Text="Controls which Windows 11 internal feature is monitored. Only change if recommended for your Windows build."
                                               FontFamily="{StaticResource GlassFontUi}"
                                               FontSize="12"
                                               Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox x:Name="FeatureIdInput"
                                             PlaceholderText="Feature ID"
                                             InputScope="Number"
                                             Style="{StaticResource GlassTextBoxStyle}"
                                             Width="120"
                                             AutomationProperties.Name="Windows lock-screen feature ID input" />
                                    <Button x:Name="SaveFeatureIdButton"
                                            Content="Save ID"
                                            Click="SaveFeatureId_Click"
                                            Style="{StaticResource GlassButtonStyle}"
                                            AutomationProperties.Name="Save Windows lock-screen feature ID" />
                                    <Button x:Name="ResetFeatureIdButton"
                                            Content="Reset"
                                            Click="ResetFeatureId_Click"
                                            Style="{StaticResource GlassButtonStyle}"
                                            AutomationProperties.Name="Reset Windows lock-screen feature ID to default" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DefaultFeatureIdText"
                                       FontFamily="{StaticResource GlassFontMonospace}"
                                       FontSize="11"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <InfoBar x:Name="FeatureIdStatus" IsOpen="False" />
                        </StackPanel>

                        <!-- Hairline Divider -->
                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                        <!-- Windows 11 Image Feature Override Row (48px) -->
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Windows 11 image feature override"
                                               FontFamily="{StaticResource GlassFontUi}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                    <TextBlock Text="Controls internal feature (ID 38943831). Keeping it enabled forces static picture rendering and blocks animations."
                                               FontFamily="{StaticResource GlassFontUi}"
                                               FontSize="12"
                                               Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="EnableWindowsImageFeatureButton"
                                        Grid.Column="1"
                                        Content="Enable feature"
                                        Click="EnableWindowsImageFeature_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource GlassButtonStyle}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Enable Windows lock-screen feature" />
                            </Grid>
                            <TextBlock x:Name="FeatureStateText"
                                       FontFamily="{StaticResource GlassFontMonospace}"
                                       FontSize="11"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            <InfoBar x:Name="FeatureActionStatus" IsOpen="False" />
                        </StackPanel>

                        <!-- Hairline Divider -->
                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                        <!-- Remove Animated Lockscreen (Destructive Reset) Row (48px) -->
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Remove animated lock screen"
                                               FontFamily="{StaticResource GlassFontUi}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource GlassStatusAlertBrush}" />
                                    <TextBlock Text="Clears all animated GIF files from the Windows cache and restores your default Windows static lock screen."
                                               FontFamily="{StaticResource GlassFontUi}"
                                               FontSize="12"
                                               Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="RemoveLockscreenButton"
                                        Grid.Column="1"
                                        Content="Restore"
                                        Click="RemoveLockscreen_Click"
                                        Style="{StaticResource MaterialOutlinedButtonStyle}"
                                        Foreground="{ThemeResource GlassStatusAlertBrush}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Remove animated lock screen from Windows" />
                            </Grid>
                            <InfoBar x:Name="RemovalStatus" IsOpen="False" IsClosable="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. System Startup & Wallpaper -->
            <StackPanel Spacing="8">
                <TextBlock Text="DESKTOP WALLPAPER &amp; STARTUP"
                           FontFamily="{StaticResource GlassFontMonospace}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />

                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource GlassRadiusControl}"
                        Padding="20,12">
                    <Grid ColumnSpacing="16" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Run at Windows startup"
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Automatically launches LockscreenGif in the background and restores your active wallpaper when signing into Windows."
                                       FontFamily="{StaticResource GlassFontUi}"
                                       FontSize="12"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Style="{StaticResource GlassToggleSwitchStyle}"
                                      IsOn="{x:Bind ViewModel.IsRunAtStartup, Mode=TwoWay}"
                                      AutomationProperties.Name="Run at Windows startup" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 4. Diagnostics, Logs & Privacy -->
            <StackPanel Spacing="8">
                <TextBlock Text="DIAGNOSTICS &amp; PRIVACY"
                           FontFamily="{StaticResource GlassFontMonospace}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />

                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource GlassRadiusControl}"
                        Padding="20,12">
                    <StackPanel Spacing="12">
                        <!-- Application Logs Row (48px) -->
                        <Grid ColumnSpacing="16" MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Application logs"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <TextBlock Text="Open the log folder in File Explorer or export a ZIP copy for troubleshooting."
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="12"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="OpenLogFolderButton"
                                        Content="Open logs folder"
                                        Click="OpenLogFolder_Click"
                                        Style="{StaticResource MaterialTonalButtonStyle}"
                                        AutomationProperties.Name="Open application log folder in File Explorer" />
                                <Button x:Name="SaveLogsButton"
                                        Content="Save as ZIP…"
                                        Click="SaveLogs_Click"
                                        Style="{StaticResource MaterialOutlinedButtonStyle}"
                                        AutomationProperties.Name="Save application logs as ZIP file" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="LogExportProgress" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                            <ProgressRing x:Name="LogExportRing" Width="18" Height="18" Foreground="{ThemeResource GlassEmberBrush}" IsActive="False" />
                            <TextBlock Text="Saving logs…" FontFamily="{StaticResource GlassFontUi}" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <InfoBar x:Name="LogsStatus" IsOpen="False" IsClosable="True" />

                        <!-- Hairline Divider -->
                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                        <!-- Analytics Row (48px) -->
                        <Grid ColumnSpacing="16" MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Share anonymous usage analytics"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <TextBlock Text="Shares feature usage and error outcomes with PostHog in the EU to help improve LockscreenGif. Personal paths, media, and logs are never sent."
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="12"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AnalyticsToggle"
                                          Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource GlassToggleSwitchStyle}"
                                          Toggled="AnalyticsToggle_Toggled"
                                          AutomationProperties.Name="Share anonymous usage analytics" />
                        </Grid>
                        <InfoBar x:Name="AnalyticsStatus" IsOpen="False" IsClosable="False" Severity="Informational" />
                        <InfoBar x:Name="AnalyticsSettingsError" IsOpen="False" Severity="Warning"
                                 Title="Could not save preference"
                                 Message="Analytics is off for this session, but the preference could not be saved to disk." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 5. About Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="ABOUT"
                           FontFamily="{StaticResource GlassFontMonospace}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />

                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource GlassRadiusControl}"
                        Padding="24,20">
                    <StackPanel Spacing="16">
                        <!-- Identity Row -->
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/WindowIcon.png" Width="42" Height="42" VerticalAlignment="Center" />
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="LockscreenGif"
                                               FontFamily="{StaticResource GlassFontUi}"
                                               FontWeight="SemiBold"
                                               FontSize="18"
                                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                    <!-- Clean display version without build suffix -->
                                    <Border Background="{ThemeResource GlassSubtleBrush}"
                                            BorderBrush="{ThemeResource GlassHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource GlassRadiusSmall}"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind AppVersion, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind helpers:BuildInfo.DisplayVersion, Mode=OneTime}"
                                                   FontFamily="{StaticResource GlassFontMonospace}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource GlassSubtleBrush}"
                                            BorderBrush="{ThemeResource GlassHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource GlassRadiusSmall}"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Windows 11"
                                                   FontFamily="{StaticResource GlassFontUi}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Developed and maintained by Subham Kumar (SubhamPro11)"
                                           FontFamily="{StaticResource GlassFontUi}"
                                           FontSize="12"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="A modern Windows 11 utility for setting animated GIFs and video loops as your lock screen."
                                   FontFamily="{StaticResource GlassFontUi}"
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />

                        <!-- Community & Project Links -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton Content="Website"
                                             Style="{StaticResource GlassHyperlinkButtonStyle}"
                                             NavigateUri="https://lockscreen-gtf-web.morbius.workers.dev"
                                             AutomationProperties.Name="Visit LockscreenGif website" />
                            <TextBlock Text="·" Foreground="{ThemeResource GlassTextTertiaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="GitHub Repository"
                                             Style="{StaticResource GlassHyperlinkButtonStyle}"
                                             NavigateUri="https://github.com/SubhamPro11/lockscreengtf"
                                             AutomationProperties.Name="View source code on GitHub" />
                            <TextBlock Text="·" Foreground="{ThemeResource GlassTextTertiaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Report an Issue"
                                             Style="{StaticResource GlassHyperlinkButtonStyle}"
                                             NavigateUri="https://github.com/SubhamPro11/lockscreengtf/issues"
                                             AutomationProperties.Name="Report an issue on GitHub" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" Margin="0,2,0,2" />

                        <!-- Open-Source Licenses Action -->
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="ViewLicensesButton"
                                    Click="ViewLicenses_Click"
                                    Style="{StaticResource MaterialTonalButtonStyle}"
                                    Content="Open-source licenses"
                                    AutomationProperties.Name="View open-source software licenses" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>