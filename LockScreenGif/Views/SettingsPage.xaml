<Page
    x:Class="LockscreenGif.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:LockscreenGif.Helpers">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" MaxWidth="{StaticResource AppPageMaxWidth}" Margin="{StaticResource AppPageMargin}" Spacing="{StaticResource AppCardSpacing}">
            <!-- Page Title -->
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- Lock Screen Behavior Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Lock screen behavior" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Set lock screen through Windows API" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Asks Windows to apply an image before LockscreenGif writes animation files, helping Windows detect file changes."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WindowsApiToggle" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource GlassToggleSwitchStyle}"
                                          IsOn="{x:Bind ViewModel.Preferences.UseWindowsApi, Mode=TwoWay}"
                                          AutomationProperties.Name="Set lock screen through Windows API" />
                        </Grid>
                        <InfoBar IsOpen="{x:Bind ViewModel.Preferences.HasSaveError, Mode=OneWay}"
                                 IsClosable="False" Severity="Warning" Title="Could not save preference"
                                 Message="The setting applies for this session, but could not be saved to disk." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- System Startup Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="System startup" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid ColumnSpacing="16" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Run at Windows startup" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock Text="Automatically launches LockscreenGif in the background and restores your active wallpaper when signing into Windows."
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Style="{StaticResource GlassToggleSwitchStyle}"
                                      IsOn="{x:Bind ViewModel.IsRunAtStartup, Mode=TwoWay}"
                                      AutomationProperties.Name="Run at Windows startup" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Logs Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Logs" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Application logs" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Open the log folder in File Explorer or export a ZIP copy for troubleshooting."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="OpenLogFolderButton" Content="Open folder" Click="OpenLogFolder_Click"
                                        Style="{StaticResource GlassButtonStyle}"
                                        AutomationProperties.Name="Open application log folder in File Explorer" />
                                <Button x:Name="SaveLogsButton" Content="Save as ZIP…" Click="SaveLogs_Click"
                                        Style="{StaticResource GlassButtonStyle}"
                                        AutomationProperties.Name="Save application logs as ZIP file" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="LogExportProgress" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                            <ProgressRing x:Name="LogExportRing" Width="18" Height="18" Foreground="{ThemeResource GlassAccentBrassBrush}" IsActive="False" />
                            <TextBlock Text="Saving logs…" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <InfoBar x:Name="LogsStatus" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Analytics Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Analytics" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Share anonymous usage analytics" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Shares feature usage and error outcomes with PostHog in the EU to help improve LockscreenGif. Personal paths, media, and logs are never sent."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AnalyticsToggle" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource GlassToggleSwitchStyle}"
                                          Toggled="AnalyticsToggle_Toggled" />
                        </Grid>
                        <InfoBar x:Name="AnalyticsStatus" IsOpen="False" IsClosable="False" Severity="Informational" />
                        <InfoBar x:Name="AnalyticsSettingsError" IsOpen="False" Severity="Warning"
                                 Title="Could not save preference"
                                 Message="Analytics is off for this session, but the preference could not be saved to disk." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Advanced Windows Feature Settings -->
            <StackPanel Spacing="8">
                <TextBlock Text="Advanced system settings" Style="{StaticResource SectionTitleStyle}" />
                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                         Title="Notice"
                         Message="Enabling the Windows image feature will break animated GIF lock screens on Windows 11 25H2 and later. Keep it disabled for animations to play." />

                <!-- Feature ID Card -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Lock-screen feature ID" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Controls which Windows 11 internal feature is monitored. Only change if recommended for your Windows build."
                                   Style="{StaticResource SettingDescriptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="FeatureIdInput" Header="Feature ID" InputScope="Number"
                                     Style="{StaticResource GlassTextBoxStyle}"
                                     Width="180" HorizontalAlignment="Left" />
                            <Button x:Name="SaveFeatureIdButton" Content="Save ID" Click="SaveFeatureId_Click" VerticalAlignment="Bottom"
                                    Style="{StaticResource GlassButtonStyle}"
                                    AutomationProperties.Name="Save Windows lock-screen feature ID" />
                            <Button x:Name="ResetFeatureIdButton" Content="Reset to default" Click="ResetFeatureId_Click" VerticalAlignment="Bottom"
                                    Style="{StaticResource GlassButtonStyle}"
                                    AutomationProperties.Name="Reset Windows lock-screen feature ID to default" />
                        </StackPanel>
                        <TextBlock x:Name="DefaultFeatureIdText" Foreground="{ThemeResource GlassTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                        <InfoBar x:Name="FeatureIdStatus" IsOpen="False" />
                    </StackPanel>
                </Border>

                <!-- Re-enable Windows Feature Card -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Windows 11 image feature override" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Controls the internal Windows feature (ID 48433719). Keeping it enabled forces static picture rendering and blocks GIF animations."
                                   Style="{StaticResource SettingDescriptionStyle}" />
                        <TextBlock x:Name="FeatureStateText" Text="Reading current feature state…"
                                   Foreground="{ThemeResource GlassTextPrimaryBrush}" TextWrapping="Wrap" FontSize="12" />
                        <Button x:Name="EnableWindowsImageFeatureButton" Content="Enable Windows image feature"
                                Click="EnableWindowsImageFeature_Click" IsEnabled="False"
                                Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Left"
                                AutomationProperties.Name="Enable Windows lock-screen feature" />
                        <InfoBar x:Name="FeatureActionStatus" IsOpen="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Destructive Action: Remove Lockscreen -->
            <StackPanel Spacing="8">
                <TextBlock Text="Reset lock screen" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource GlassCardStyle}"
                        BorderBrush="{ThemeResource GlassStatusAlertBrush}">
                    <Grid ColumnSpacing="16" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Remove Animated Lockscreen" Style="{StaticResource SettingTitleStyle}"
                                       Foreground="{ThemeResource GlassStatusAlertBrush}" />
                            <TextBlock Text="Clears all animated GIF files from the Windows cache and restores your standard Windows static lock screen."
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="RemoveLockscreenButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="RemoveLockscreen_Click" Content="Remove"
                                Style="{StaticResource GlassDestructiveButtonStyle}"
                                AutomationProperties.Name="Remove animated lock screen from Windows" />
                    </Grid>
                </Border>
                <InfoBar x:Name="RemovalStatus" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="About" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource GlassCardElevatedStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/WindowIcon.png" Width="40" Height="40" VerticalAlignment="Center" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="LockscreenGif"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                    <Border Background="{ThemeResource GlassSurfaceSubtleBrush}"
                                            BorderBrush="{ThemeResource GlassBorderRimBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AppCornerRadiusControl}"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:BuildInfo.ShortDisplayVersion, Mode=OneTime}"
                                                   ToolTipService.ToolTip="{x:Bind helpers:BuildInfo.DisplayVersion, Mode=OneTime}"
                                                   FontFamily="{StaticResource GlassFontMonospace}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource GlassSurfaceSubtleBrush}"
                                            BorderBrush="{ThemeResource GlassBorderRimBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AppCornerRadiusControl}"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Windows 11"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Maintained and enhanced by Subham Kumar (SubhamPro11) · Based on LockscreenGif by Leapward-Koex"
                                           FontSize="12"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="A modern Windows 11 utility for setting animated GIFs and video loops as your lock screen."
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton Content="Website"
                                             Style="{StaticResource GlassHyperlinkButtonStyle}"
                                             NavigateUri="https://lockscreen-gtf-web.morbius.workers.dev"
                                             AutomationProperties.Name="Visit LockscreenGif website" />
                            <TextBlock Text="·" Foreground="{ThemeResource GlassTextSecondaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="GitHub Repository"
                                             Style="{StaticResource GlassHyperlinkButtonStyle}"
                                             NavigateUri="https://github.com/SubhamPro11/lockscreengtf"
                                             AutomationProperties.Name="View source code on GitHub" />
                            <TextBlock Text="·" Foreground="{ThemeResource GlassTextSecondaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Report an Issue"
                                             Style="{StaticResource GlassHyperlinkButtonStyle}"
                                             NavigateUri="https://github.com/SubhamPro11/lockscreengtf/issues"
                                             AutomationProperties.Name="Report an issue on GitHub" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource GlassBorderRimBrush}" Margin="0,2,0,2" />

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="ViewLicensesButton"
                                    Click="ViewLicenses_Click"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Content="Open-source licenses"
                                    AutomationProperties.Name="View open-source software licenses" />
                            <TextBlock Text="Based on LockscreenGif by Leapward-Koex (MIT)"
                                       FontSize="12"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>