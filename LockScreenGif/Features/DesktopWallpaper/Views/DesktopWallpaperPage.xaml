<Page
    x:Class="LockscreenGif.Features.DesktopWallpaper.Views.DesktopWallpaperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LockscreenGif.Features.DesktopWallpaper.Models"
    xmlns:vm="using:LockscreenGif.Features.DesktopWallpaper.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource AppSpacingL}" Margin="{StaticResource AppMarginPage}">

            <!-- Page Header -->
            <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                <TextBlock Text="Desktop Wallpaper"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                <TextBlock Text="Display live animated videos, interactive web pages, or images behind your Windows 11 desktop icons."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
            </StackPanel>

            <!-- Error InfoBar -->
            <InfoBar x:Name="ErrorBanner"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Desktop wallpaper notice"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- Wallpaper Selection & Drop Target Card -->
            <Border x:Name="DropTargetCard"
                    Style="{StaticResource GlassCardStyle}"
                    AllowDrop="True"
                    DragOver="DropTarget_DragOver"
                    DragLeave="DropTarget_DragLeave"
                    Drop="DropTarget_Drop">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Select Wallpaper Media"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Drag and drop a file here, choose from disk, or load a web URL."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}">
                            <Button x:Name="ChooseFileButton"
                                    Content="Choose File"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="ChooseFile_Click"
                                    AutomationProperties.Name="Choose wallpaper media file">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>

                            <Button x:Name="ApplyWallpaperButton"
                                    Content="Apply to Desktop"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ApplyWallpaperCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                                    AutomationProperties.Name="Apply selected wallpaper to desktop" />
                        </StackPanel>
                    </Grid>

                    <!-- Web URL input row -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="UrlInputBox"
                                 PlaceholderText="Enter a web wallpaper URL (e.g. https://... or http://localhost:...)"
                                 Text="{x:Bind ViewModel.SourceInput, Mode=TwoWay}"
                                 Style="{StaticResource GlassTextBoxStyle}"
                                 AutomationProperties.Name="Web wallpaper URL input" />

                        <Button Grid.Column="1"
                                Content="Load URL"
                                Style="{StaticResource GlassButtonStyle}"
                                Click="LoadUrl_Click"
                                AutomationProperties.Name="Load entered web wallpaper URL" />
                    </Grid>

                    <!-- Selected Media Info Row -->
                    <Border Background="{ThemeResource GlassSurfaceSubtleBrush}"
                            BorderBrush="{ThemeResource GlassBorderRimBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppCornerRadiusControl}"
                            Padding="12,8">
                        <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE8B9;"
                                      FontSize="{StaticResource AppFontSizeSubtitle}"
                                      Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.WallpaperTitle, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.SourceInput, Mode=OneWay, TargetNullValue='No file or URL selected yet.'}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="{ThemeResource GlassBorderSubtleBrush}"
                                    CornerRadius="{StaticResource AppCornerRadiusControl}"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.WallpaperTypeDescription, Mode=OneWay}"
                                           FontSize="{StaticResource AppFontSizeCaption}"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Wallpaper Library & Playlists Card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Wallpaper Library"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Manage your saved wallpapers, favorites, and automatic rotation playlists."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Search & Filter Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}">
                            <TextBox x:Name="SearchBox"
                                     PlaceholderText="Search wallpapers…"
                                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                     Width="200"
                                     Style="{StaticResource GlassTextBoxStyle}"
                                     AutomationProperties.Name="Search wallpaper library" />

                            <ToggleButton IsChecked="{x:Bind ViewModel.FilterFavoritesOnly, Mode=TwoWay}"
                                          Content="★ Favorites"
                                          Style="{StaticResource GlassToggleButtonStyle}"
                                          AutomationProperties.Name="Filter favorites only" />
                        </StackPanel>
                    </Grid>

                    <!-- Library Items List / Grid -->
                    <ListView ItemsSource="{x:Bind ViewModel.LibraryItems, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedLibraryEntry, Mode=TwoWay}"
                              SelectionMode="Single"
                              MaxHeight="260"
                              AutomationProperties.Name="Saved wallpaper library list">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:WallpaperLibraryEntry">
                                <Grid Padding="6,8" ColumnSpacing="{StaticResource AppSpacingM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Type Icon / Thumbnail -->
                                    <Border Width="40" Height="40"
                                            Background="{ThemeResource GlassSurfaceSubtleBrush}"
                                            CornerRadius="{StaticResource AppCornerRadiusControl}"
                                            BorderBrush="{ThemeResource GlassBorderSubtleBrush}"
                                            BorderThickness="1">
                                        <FontIcon Glyph="{x:Bind TypeGlyph, Mode=OneWay}" FontSize="{StaticResource AppFontSizeBody}" Foreground="{ThemeResource GlassTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title & Path -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource GlassTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SourcePathOrUrl, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource GlassTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Favorite Toggle -->
                                    <Button Grid.Column="2"
                                            Click="LibraryEntry_Favorite_Click"
                                            Style="{StaticResource GlassButtonStyle}"
                                            Padding="8,4"
                                            AutomationProperties.Name="Toggle favorite">
                                        <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="{StaticResource AppFontSizeCaption}" />
                                    </Button>

                                    <!-- Delete Button with confirmation -->
                                    <Button Grid.Column="3"
                                            Content="Delete"
                                            Click="LibraryEntry_Delete_Click"
                                            Style="{StaticResource GlassButtonStyle}"
                                            Padding="8,4"
                                            AutomationProperties.Name="Delete wallpaper from library" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Playlists Configuration Row -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Automatic Playlist Rotation"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Automatically cycle through wallpapers in your library on a timed schedule."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" VerticalAlignment="Center">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsPlaylistEnabled, Mode=TwoWay}"
                                          OnContent="Enabled"
                                          OffContent="Disabled"
                                          AutomationProperties.Name="Enable playlist rotation" />

                            <ComboBox SelectedIndex="{x:Bind ViewModel.PlaylistIntervalIndex, Mode=TwoWay}"
                                      Width="130"
                                      Style="{StaticResource GlassComboBoxStyle}"
                                      AutomationProperties.Name="Playlist rotation interval">
                                <ComboBoxItem Content="Every 5 min" />
                                <ComboBoxItem Content="Every 15 min" />
                                <ComboBoxItem Content="Every 30 min" />
                                <ComboBoxItem Content="Every hour" />
                                <ComboBoxItem Content="Daily" />
                            </ComboBox>

                            <Button Content="Next"
                                    Command="{x:Bind ViewModel.RotateNextCommand}"
                                    Style="{StaticResource GlassButtonStyle}"
                                    AutomationProperties.Name="Rotate to next wallpaper" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Playback & Fit Controls Card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <TextBlock Text="Playback &amp; Fit Settings"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />

                    <!-- Fit Mode -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Scaling mode"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Choose how media is positioned on your display."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.FitModeIndex, Mode=TwoWay}"
                                  Style="{StaticResource GlassComboBoxStyle}"
                                  AutomationProperties.Name="Wallpaper fit mode">
                            <ComboBoxItem Content="Fill (Crop to cover)" />
                            <ComboBoxItem Content="Fit (Letterbox full content)" />
                            <ComboBoxItem Content="Stretch (Fit entire screen)" />
                            <ComboBoxItem Content="Center (Original size)" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Audio Volume & Mute -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Audio playback"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Adjust audio output volume and mute status for video or web wallpapers."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" VerticalAlignment="Center">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsMuted, Mode=TwoWay}"
                                          OnContent="Muted"
                                          OffContent="Unmuted"
                                          AutomationProperties.Name="Mute wallpaper audio" />

                            <Slider Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="100"
                                    Width="120"
                                    AutomationProperties.Name="Wallpaper volume slider" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Playback Speed & Loop -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Speed &amp; repetition"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Control video playback rate and continuous looping."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}">
                            <ComboBox SelectedIndex="{x:Bind ViewModel.SpeedIndex, Mode=TwoWay}"
                                      Width="110"
                                      Style="{StaticResource GlassComboBoxStyle}"
                                      AutomationProperties.Name="Playback speed">
                                <ComboBoxItem Content="0.5x" />
                                <ComboBoxItem Content="1.0x" />
                                <ComboBoxItem Content="1.5x" />
                                <ComboBoxItem Content="2.0x" />
                            </ComboBox>

                            <ToggleSwitch IsOn="{x:Bind ViewModel.Loop, Mode=TwoWay}"
                                          OnContent="Loop"
                                          OffContent="Once"
                                          AutomationProperties.Name="Loop playback" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Interactive Desktop Input (Web Wallpapers) -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Forward mouse input to wallpaper"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Enables mouse clicks and cursor interaction on web wallpapers (WebGL, canvas, shaders)."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.ForwardInput, Mode=TwoWay}"
                                      AutomationProperties.Name="Forward desktop mouse interaction" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Engine Status & Primary Control Card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <Grid RowSpacing="{StaticResource AppSpacingM}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}">
                                <TextBlock Text="Wallpaper Engine Status"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                <Border Background="{ThemeResource GlassSurfaceSubtleBrush}"
                                        BorderBrush="{ThemeResource GlassBorderRimBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AppCornerRadiusControl}"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                               FontSize="{StaticResource AppFontSizeCaption}"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ActiveTargetDescription, Mode=OneWay, TargetNullValue='Engine is currently idle. Press Start or Apply to attach to the desktop background layer.'}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Control Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" VerticalAlignment="Center">
                            <Button x:Name="PauseResumeButton"
                                    Content="{x:Bind ViewModel.PauseResumeButtonText, Mode=OneWay}"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Command="{x:Bind ViewModel.TogglePauseCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanPauseResume, Mode=OneWay}"
                                    AutomationProperties.Name="Pause or resume wallpaper playback" />

                            <Button x:Name="StartEngineButton"
                                    Content="Start Engine"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.StartCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.StartButtonVisibility, Mode=OneWay}"
                                    AutomationProperties.Name="Start desktop wallpaper engine" />

                            <Button x:Name="StopEngineButton"
                                    Content="Stop Engine"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Command="{x:Bind ViewModel.StopCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.StopButtonVisibility, Mode=OneWay}"
                                    AutomationProperties.Name="Stop desktop wallpaper engine" />
                        </StackPanel>
                    </Grid>

                    <!-- Real-time Resource Usage Readout Row -->
                    <Border Background="{ThemeResource GlassSurfaceSubtleBrush}"
                            BorderBrush="{ThemeResource GlassBorderRimBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppCornerRadiusControl}"
                            Padding="12,8">
                        <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingXS}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE950;" FontSize="{StaticResource AppFontSizeCaption}" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="CPU:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingXS}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B9;" FontSize="{StaticResource AppFontSizeCaption}" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="RAM:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Text="{x:Bind ViewModel.AutoPausedReasonText, Mode=OneWay, TargetNullValue='Wallpaper running smoothly'}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Smart Performance & Power Rules Card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <TextBlock Text="Smart Performance &amp; Power Rules"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />

                    <!-- Rule 1: Fullscreen apps & games -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Pause when fullscreen app or game is focused"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Suspends video decoding and web rendering while gaming or using fullscreen applications."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.PauseWhenFullscreenAppActive, Mode=TwoWay}"
                                      AutomationProperties.Name="Pause when fullscreen app is active" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Rule 2: Desktop Covered -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Pause when desktop is fully covered"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Pauses rendering when active windows are maximized over the desktop."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.PauseWhenDesktopCovered, Mode=TwoWay}"
                                      AutomationProperties.Name="Pause when desktop is fully covered" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Rule 3: Battery & Battery Saver -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Pause in battery saver mode"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Automatically pauses wallpaper whenever Windows battery saver is turned on."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.PauseInBatterySaver, Mode=TwoWay}"
                                      AutomationProperties.Name="Pause in battery saver mode" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Rule 4: Pause On Battery (General) -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Pause on battery power"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Always pause wallpaper playback when unplugged from AC power (default off)."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.PauseOnBattery, Mode=TwoWay}"
                                      AutomationProperties.Name="Pause on battery power" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Rule 5: Screen Locked or Display Off -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Pause when PC is locked or display is turned off"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Stops rendering when the workstation is locked (Win+L) or monitors sleep."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.PauseWhenLockedOrDisplayOff, Mode=TwoWay}"
                                      AutomationProperties.Name="Pause when PC is locked" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- FPS Limit & Decode Quality -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Frame rate limit"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Cap playback frame rate to reduce GPU utilization and thermals."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.FpsLimitIndex, Mode=TwoWay}"
                                  Style="{StaticResource GlassComboBoxStyle}"
                                  AutomationProperties.Name="Frame rate limit">
                            <ComboBoxItem Content="60 FPS (Fluid)" />
                            <ComboBoxItem Content="30 FPS (Standard)" />
                            <ComboBoxItem Content="15 FPS (Power saving)" />
                            <ComboBoxItem Content="Unlimited" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Lower Decode Quality Toggle -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Lower decode quality"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Favors power efficiency over maximum resolution decoding for background video."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.LowerDecodeQuality, Mode=TwoWay}"
                                      AutomationProperties.Name="Lower decode quality" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Multi-Monitor & Placement Card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <TextBlock Text="Display &amp; Monitors"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />

                    <!-- Layout Mode Selector -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Multi-monitor layout"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Choose whether to span wallpaper across all screens or select a specific monitor."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.LayoutModeIndex, Mode=TwoWay}"
                                  Style="{StaticResource GlassComboBoxStyle}"
                                  AutomationProperties.Name="Multi-monitor layout mode">
                            <ComboBoxItem Content="Span all displays" />
                            <ComboBoxItem Content="Single display" />
                            <ComboBoxItem Content="Duplicate on each" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Monitor Selection -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Detected displays"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Per-monitor DPI awareness and resolution detection."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}">
                            <ComboBox x:Name="MonitorPicker"
                                      ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="260"
                                      Style="{StaticResource GlassComboBoxStyle}"
                                      AutomationProperties.Name="Selected display monitor" />

                            <Button Content="Refresh"
                                    Command="{x:Bind ViewModel.RefreshMonitorsCommand}"
                                    Style="{StaticResource GlassButtonStyle}"
                                    AutomationProperties.Name="Refresh display monitors" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Advanced & Safeguards Card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <TextBlock Text="Advanced Options &amp; Safeguards"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource GlassTextPrimaryBrush}" />

                    <!-- Executable Wallpapers Switch -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource AppSpacingXXS}">
                            <TextBlock Text="Allow executable (.exe) wallpapers"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            <TextBlock Text="Permits running user-selected native Windows programs behind the desktop. Default is Off for system security."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="AdvancedExeToggle"
                                      IsOn="{x:Bind ViewModel.AllowAdvancedExecutables, Mode=OneWay}"
                                      Toggled="AdvancedExeToggle_Toggled"
                                      AutomationProperties.Name="Allow executable wallpapers switch" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GlassBorderSubtleBrush}" />

                    <!-- Original Wallpaper Safeguard info -->
                    <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72D;"
                                  FontSize="{StaticResource AppFontSizeBody}"
                                  Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.OriginalWallpaperPath, Mode=OneWay, TargetNullValue='Safeguard: Windows default / System managed wallpaper will restore upon stopping.'}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
