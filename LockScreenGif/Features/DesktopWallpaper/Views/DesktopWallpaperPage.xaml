<Page
    x:Class="LockscreenGif.Features.DesktopWallpaper.Views.DesktopWallpaperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LockscreenGif.Features.DesktopWallpaper.Models"
    xmlns:vm="using:LockscreenGif.Features.DesktopWallpaper.ViewModels"
    mc:Ignorable="d"
    UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,0,48">
        <Grid x:Name="LayoutRootGrid" HorizontalAlignment="Center" MaxWidth="1280" Padding="36,20,36,32" ColumnSpacing="36">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideLayoutState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="980" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="CompactLayoutState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="LayoutRootGrid.Padding" Value="20,16,20,32" />
                            <Setter Target="LayoutRootGrid.ColumnSpacing" Value="0" />
                            <Setter Target="LeftColumnDef.Width" Value="*" />
                            <Setter Target="RightColumnDef.Width" Value="0" />
                            <Setter Target="SettingsPanel.(Grid.Column)" Value="0" />
                            <Setter Target="SettingsPanel.(Grid.Row)" Value="1" />
                            <Setter Target="SettingsPanel.Margin" Value="0,24,0,0" />
                            <Setter Target="DropTargetCard.MinHeight" Value="300" />
                            <Setter Target="ActivePreviewBorder.MinHeight" Value="320" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="1.6*" />
                <ColumnDefinition x:Name="RightColumnDef" Width="*" MaxWidth="420" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =================================================================== -->
            <!-- LEFT COLUMN: DESKTOP PREVIEW STAGE, PLAYBACK TRAY & URL INPUT       -->
            <!-- =================================================================== -->
            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="18">
                <!-- System / Error / Sync InfoBars -->
                <InfoBar x:Name="ErrorBanner"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Title="Desktop wallpaper notice"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Retry"
                                Command="{x:Bind ViewModel.ApplyWallpaperCommand}"
                                Style="{StaticResource MaterialTonalButtonStyle}"
                                AutomationProperties.Name="Retry applying wallpaper" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="SyncNoticeBanner"
                         IsOpen="{x:Bind ViewModel.HasSyncNotice, Mode=OneWay}"
                         Severity="Informational"
                         Title="Lock screen &amp; desktop sync"
                         Message="{x:Bind ViewModel.SyncNotice, Mode=OneWay}"
                         IsClosable="True" />

                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}">
                    <ProgressBar IsIndeterminate="True"
                                 Foreground="{ThemeResource GlassPrimaryBrush}"
                                 HorizontalAlignment="Stretch" />
                    <TextBlock Text="Preparing and rendering wallpaper…"
                               FontSize="12"
                               Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                </StackPanel>

                <!-- A: Drop Target State (Shown when no media loaded) -->
                <Grid Visibility="{x:Bind ViewModel.MediaPlaceholderVisibility, Mode=OneWay}">
                    <Border x:Name="DropTargetCard"
                            AllowDrop="True"
                            DragOver="DropTarget_DragOver"
                            DragLeave="DropTarget_DragLeave"
                            Drop="DropTarget_Drop"
                            Background="{ThemeResource GlassStageSurfaceBrush}"
                            CornerRadius="28"
                            MinHeight="360"
                            Padding="36,48">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <FontIcon Glyph="&#xE8B9;" FontSize="44" Foreground="{ThemeResource GlassPrimaryBrush}"
                                      HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Drop a video, GIF, or web page"
                                       Style="{StaticResource PageTitleStyle}"
                                       FontSize="30" FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}"
                                       TextAlignment="Center" />
                            <TextBlock Text="MP4 · WebM · MKV · MOV · GIF · WebP · HTML · Images"
                                       FontFamily="{StaticResource GlassFontMonospace}"
                                       FontSize="12"
                                       Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                       TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button x:Name="ChooseFileButton"
                                        Content="Choose file…"
                                        Style="{StaticResource MaterialFilledButtonLargeStyle}"
                                        Click="ChooseFile_Click"
                                        AutomationProperties.Name="Choose wallpaper media file">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Rectangle RadiusX="28" RadiusY="28"
                               Stroke="{ThemeResource GlassOutlineVariantBrush}"
                               StrokeThickness="1.5"
                               StrokeDashArray="6,4"
                               IsHitTestVisible="False" />
                </Grid>

                <!-- B: Active Media Desktop Preview Stage (Shown when media is loaded) -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.MediaSelectedVisibility, Mode=OneWay}">
                    <Border x:Name="ActivePreviewBorder" MinHeight="360" CornerRadius="28"
                            BorderBrush="{ThemeResource GlassOutlineVariantBrush}"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4D1F1A" Offset="0.0" />
                                <GradientStop Color="#241217" Offset="0.4" />
                                <GradientStop Color="#120D12" Offset="0.75" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Simulated Desktop Icons (Left Edge, Figma 7:618) -->
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,28,0,0" Spacing="18" IsHitTestVisible="False" Opacity="0.75">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#F5EDE5" />
                                    </Border>
                                    <TextBlock Text="Recycle Bin" FontSize="10" Foreground="#F5EDE5" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="#F5EDE5" />
                                    </Border>
                                    <TextBlock Text="Projects" FontSize="10" Foreground="#F5EDE5" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <FontIcon Glyph="&#xE70B;" FontSize="15" Foreground="#F5EDE5" />
                                    </Border>
                                    <TextBlock Text="Notes" FontSize="10" Foreground="#F5EDE5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Centered Active Media Readout -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="96,24,48,24">
                                <Border Width="60" Height="60" CornerRadius="30"
                                        Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="26" Foreground="#FFB4A8" />
                                </Border>

                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.WallpaperTitle, Mode=OneWay}"
                                               FontFamily="{StaticResource GlassFontDisplay}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="#F5EDE5" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                    <TextBlock Text="{x:Bind ViewModel.SourceInput, Mode=OneWay, TargetNullValue='No file or URL selected yet.'}"
                                               FontFamily="{StaticResource GlassFontMonospace}"
                                               FontSize="12" Foreground="#D8C2BE"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                                </StackPanel>

                                <!-- Type & Status Badges -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Border Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                            CornerRadius="999" Padding="12,4">
                                        <TextBlock Text="{x:Bind ViewModel.WallpaperTypeDescription, Mode=OneWay}"
                                                   FontFamily="{StaticResource GlassFontUi}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#F5EDE5" />
                                    </Border>
                                    <Border Background="#38FFB4A8" BorderBrush="#55FFB4A8" BorderThickness="1"
                                            CornerRadius="999" Padding="12,4">
                                        <TextBlock Text="{x:Bind ViewModel.StateBadgeText, Mode=OneWay}"
                                                   FontFamily="{StaticResource GlassFontMonospace}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#FFDAD5" />
                                    </Border>
                                </StackPanel>

                                <!-- Resource Usage Readout -->
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.ResourceUsageVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.CpuTextWithLabel, Mode=OneWay}"
                                               FontFamily="{StaticResource GlassFontMonospace}" FontSize="11" Foreground="#D8C2BE" />
                                    <TextBlock Text="·" Foreground="#9A8582" />
                                    <TextBlock Text="{x:Bind ViewModel.MemoryTextWithLabel, Mode=OneWay}"
                                               FontFamily="{StaticResource GlassFontMonospace}" FontSize="11" Foreground="#D8C2BE" />
                                    <TextBlock Text="{x:Bind ViewModel.AutoPausedReasonText, Mode=OneWay}"
                                               FontFamily="{StaticResource GlassFontUi}" FontSize="11"
                                               Foreground="{ThemeResource GlassStatusAlertBrush}"
                                               Visibility="{x:Bind ViewModel.AutoPausedVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Simulated Windows 11 Taskbar Strip (Bottom, Figma 7:624) -->
                            <Border Grid.Row="1" Height="36" Background="#33000000" CornerRadius="0,0,28,28" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="4" Background="#44FFFFFF" />
                                    <Border Width="18" Height="18" CornerRadius="4" Background="#33FFFFFF" />
                                    <Border Width="18" Height="18" CornerRadius="4" Background="#33FFFFFF" />
                                    <Border Width="18" Height="18" CornerRadius="4" Background="#33FFFFFF" />
                                    <Border Width="18" Height="18" CornerRadius="4" Background="#33FFFFFF" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Floating Playback Tray (Figma 7:630) -->
                    <Border Background="{ThemeResource GlassTrayFillBrush}"
                            BorderBrush="{ThemeResource GlassTrayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="8"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="PauseResumeButton"
                                    Content="{x:Bind ViewModel.PauseResumeButtonText, Mode=OneWay}"
                                    Style="{StaticResource MaterialTonalButtonStyle}"
                                    Command="{x:Bind ViewModel.TogglePauseCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanPauseResume, Mode=OneWay}"
                                    AutomationProperties.Name="Pause or resume wallpaper" />

                            <Button x:Name="StartEngineButton"
                                    Content="Start"
                                    Style="{StaticResource MaterialFilledButtonStyle}"
                                    Command="{x:Bind ViewModel.StartCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.StartButtonVisibility, Mode=OneWay}"
                                    AutomationProperties.Name="Start desktop wallpaper engine" />

                            <Button x:Name="StopEngineButton"
                                    Content="Stop"
                                    Style="{StaticResource MaterialOutlinedButtonStyle}"
                                    Command="{x:Bind ViewModel.StopCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.StopButtonVisibility, Mode=OneWay}"
                                    AutomationProperties.Name="Stop wallpaper and restore Windows wallpaper" />

                            <Button Content="Change file…"
                                    Style="{StaticResource MaterialTextButtonStyle}"
                                    Click="ChooseFile_Click"
                                    AutomationProperties.Name="Choose a different wallpaper file" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Compact Web Wallpaper URL Bar -->
                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassOutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlInputBox"
                                 PlaceholderText="Or paste a web wallpaper URL (https://… or http://localhost:…)"
                                 Text="{x:Bind ViewModel.WebUrlInput, Mode=TwoWay}"
                                 Style="{StaticResource GlassTextBoxStyle}"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Web wallpaper URL input" />
                        <Button Grid.Column="1"
                                Content="Load URL"
                                Style="{StaticResource MaterialTonalButtonStyle}"
                                Click="LoadUrl_Click"
                                AutomationProperties.Name="Load entered web wallpaper URL" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- =================================================================== -->
            <!-- RIGHT COLUMN: WORKING SETTINGS PANEL                                -->
            <!-- =================================================================== -->
            <StackPanel x:Name="SettingsPanel" Grid.Column="1" Grid.Row="0" Spacing="22">
                <!-- 1. Heading & Subtitle (Figma 7:652) -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Live wallpaper"
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="32"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Plays behind your desktop icons. It pauses on its own when a game or fullscreen app is in front."
                               Style="{StaticResource SettingDescriptionStyle}"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 2. Primary CTA Buttons -->
                <StackPanel Spacing="10">
                    <Grid ToolTipService.ToolTip="{x:Bind ViewModel.ApplyButtonTooltip, Mode=OneWay}">
                        <Button x:Name="ApplyWallpaperButton"
                                Content="Apply to desktop"
                                Style="{StaticResource MaterialFilledButtonLargeStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ApplyWallpaperCommand}"
                                IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                                AutomationProperties.Name="Apply selected wallpaper to desktop" />
                    </Grid>

                    <Grid ToolTipService.ToolTip="{x:Bind ViewModel.ApplyBothTooltip, Mode=OneWay}">
                        <Button x:Name="ApplyBothButton"
                                Content="Also set as lock screen"
                                Style="{StaticResource MaterialOutlinedButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ApplyBothDesktopAndLockscreenCommand}"
                                IsEnabled="{x:Bind ViewModel.CanApplyBoth, Mode=OneWay}"
                                AutomationProperties.Name="Also set as lock screen" />
                    </Grid>
                </StackPanel>

                <!-- 3. Essential Playback Controls (Always visible, uncluttered) -->
                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassOutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18,14">
                    <StackPanel Spacing="14">
                        <!-- Scaling Mode -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scaling mode" FontSize="14" FontWeight="Medium"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MinWidth="170"
                                      SelectedIndex="{x:Bind ViewModel.FitModeIndex, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.HasActiveWallpaper, Mode=OneWay}"
                                      Style="{StaticResource GlassComboBoxStyle}"
                                      AutomationProperties.Name="Wallpaper fit mode">
                                <ComboBoxItem Content="Fill (Crop to cover)" />
                                <ComboBoxItem Content="Fit (Letterbox)" />
                                <ComboBoxItem Content="Stretch" />
                                <ComboBoxItem Content="Center" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                        <!-- Volume & Mute -->
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Volume" FontSize="14" FontWeight="Medium"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.VolumeText, Mode=OneWay}"
                                               FontFamily="{StaticResource GlassFontMonospace}" FontSize="12"
                                               Foreground="{ThemeResource GlassTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsMuted, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ViewModel.HasActiveWallpaper, Mode=OneWay}"
                                                  OffContent="Sound" OnContent="Muted"
                                                  Style="{StaticResource GlassToggleSwitchStyle}"
                                                  AutomationProperties.Name="Mute wallpaper audio" />
                                </StackPanel>
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                    Minimum="0" Maximum="100"
                                    IsEnabled="{x:Bind ViewModel.HasActiveWallpaper, Mode=OneWay}"
                                    Style="{StaticResource GlassSliderStyle}"
                                    AutomationProperties.Name="Wallpaper volume slider" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                        <!-- Pause when fullscreen -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Pause when a game is fullscreen" FontSize="14" FontWeight="Medium"
                                           Foreground="{ThemeResource GlassTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Saves battery and frames." FontSize="12"
                                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind ViewModel.PauseWhenFullscreenAppActive, Mode=TwoWay}"
                                          Style="{StaticResource GlassToggleSwitchStyle}"
                                          AutomationProperties.Name="Pause when fullscreen app is active" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource GlassHairlineBrush}" />

                        <!-- Loop playback -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Loop playback" FontSize="14" FontWeight="Medium"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind ViewModel.Loop, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.HasActiveWallpaper, Mode=OneWay}"
                                          Style="{StaticResource GlassToggleSwitchStyle}"
                                          AutomationProperties.Name="Loop playback" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Power & Smart Rules (Collapsible so UI stays calm) -->
                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassOutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,8">
                    <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Background="Transparent" AutomationProperties.Name="Performance and power rules">
                        <Expander.Resources>
                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                        </Expander.Resources>
                        <Expander.Header>
                            <TextBlock Text="Performance &amp; power rules" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                        </Expander.Header>
                        <StackPanel Spacing="12" Margin="0,10,0,4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Performance profile" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="170"
                                          ItemsSource="{x:Bind ViewModel.AvailablePresets, Mode=OneTime}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedPresetIndex, Mode=TwoWay}"
                                          Style="{StaticResource GlassComboBoxStyle}"
                                          AutomationProperties.Name="Performance profile" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Frame rate limit" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="170"
                                          SelectedIndex="{x:Bind ViewModel.FpsLimitIndex, Mode=TwoWay}"
                                          Style="{StaticResource GlassComboBoxStyle}"
                                          AutomationProperties.Name="Frame rate limit">
                                    <ComboBoxItem Content="15 FPS (Ultra Light)" />
                                    <ComboBoxItem Content="24 FPS (Cinematic)" />
                                    <ComboBoxItem Content="30 FPS (Standard)" />
                                    <ComboBoxItem Content="60 FPS (Fluid)" />
                                    <ComboBoxItem Content="Match monitor" />
                                    <ComboBoxItem Content="Adaptive" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pause when desktop is covered" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PauseWhenDesktopCovered, Mode=TwoWay}" Style="{StaticResource GlassToggleSwitchStyle}" AutomationProperties.Name="Pause when desktop is fully covered" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pause in Energy Saver mode" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PauseInBatterySaver, Mode=TwoWay}" Style="{StaticResource GlassToggleSwitchStyle}" AutomationProperties.Name="Pause in Energy Saver mode" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pause on battery power" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PauseOnBattery, Mode=TwoWay}" Style="{StaticResource GlassToggleSwitchStyle}" AutomationProperties.Name="Pause on battery power" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pause when PC is locked" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PauseWhenLockedOrDisplayOff, Mode=TwoWay}" Style="{StaticResource GlassToggleSwitchStyle}" AutomationProperties.Name="Pause when PC is locked" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Lower decode quality" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LowerDecodeQuality, Mode=TwoWay}" Style="{StaticResource GlassToggleSwitchStyle}" AutomationProperties.Name="Lower decode quality" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.GpuDescriptionText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource GlassTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BatteryImpactEstimate, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource GlassTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 5. Displays & Layout (Collapsible) -->
                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassOutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,8">
                    <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Background="Transparent" AutomationProperties.Name="Displays and layout">
                        <Expander.Resources>
                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                        </Expander.Resources>
                        <Expander.Header>
                            <TextBlock Text="Displays &amp; layout" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                        </Expander.Header>
                        <StackPanel Spacing="12" Margin="0,10,0,4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Multi-monitor layout" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="170"
                                          SelectedIndex="{x:Bind ViewModel.LayoutModeIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.HasMultipleMonitors, Mode=OneWay}"
                                          Style="{StaticResource GlassComboBoxStyle}"
                                          AutomationProperties.Name="Multi-monitor layout mode">
                                    <ComboBoxItem Content="Span all displays" />
                                    <ComboBoxItem Content="Single display" />
                                    <ComboBoxItem Content="Duplicate on each" />
                                </ComboBox>
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="One display detected" Visibility="{x:Bind ViewModel.SingleDisplayNoticeVisibility, Mode=OneWay}"
                                           FontSize="12" Foreground="{ThemeResource GlassTextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="MonitorPicker"
                                              ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Width="200"
                                              IsEnabled="{x:Bind ViewModel.IsMonitorPickerEnabled, Mode=OneWay}"
                                              Style="{StaticResource GlassComboBoxStyle}"
                                              AutomationProperties.Name="Selected display monitor" />
                                    <Button Content="Refresh"
                                            Command="{x:Bind ViewModel.RefreshMonitorsCommand}"
                                            Style="{StaticResource MaterialTonalButtonStyle}"
                                            AutomationProperties.Name="Refresh display monitors" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 6. Advanced & Web Options (Collapsible) -->
                <Border Background="{ThemeResource GlassRaisedBrush}"
                        BorderBrush="{ThemeResource GlassOutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,8">
                    <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Background="Transparent" AutomationProperties.Name="Advanced and web options">
                        <Expander.Resources>
                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                        </Expander.Resources>
                        <Expander.Header>
                            <TextBlock Text="Advanced &amp; web options" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                        </Expander.Header>
                        <StackPanel Spacing="12" Margin="0,10,0,4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Playback speed" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="140"
                                          ItemsSource="{x:Bind ViewModel.AvailableSpeeds, Mode=OneTime}"
                                          SelectedIndex="{x:Bind ViewModel.SpeedIndex, Mode=TwoWay}"
                                          Style="{StaticResource GlassComboBoxStyle}"
                                          AutomationProperties.Name="Playback speed" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Forward mouse input to web" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ForwardInput, Mode=TwoWay}" Style="{StaticResource GlassToggleSwitchStyle}" AutomationProperties.Name="Forward desktop mouse interaction" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="System audio visualization" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsAudioReactiveEnabled, Mode=TwoWay}" Style="{StaticResource GlassToggleSwitchStyle}" AutomationProperties.Name="Audio reactive visualization toggle" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Allow executable (.exe) wallpapers" FontSize="13" Foreground="{ThemeResource GlassTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="AdvancedExeToggle" Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.AllowAdvancedExecutables, Mode=OneWay}"
                                              Toggled="AdvancedExeToggle_Toggled"
                                              Style="{StaticResource GlassToggleSwitchStyle}"
                                              AutomationProperties.Name="Allow executable wallpapers switch" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.OriginalWallpaperPath, Mode=OneWay, TargetNullValue='Safeguard: Windows default wallpaper restores automatically upon stopping.'}"
                                       FontSize="11" Foreground="{ThemeResource GlassTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
