<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deliberately Different Radii Scale -->
    <!-- 1. Stage (Lockscreen preview frame): 22px -->
    <CornerRadius x:Key="GlassRadiusStage">22</CornerRadius>
    <x:Double x:Key="GlassRadiusStageDouble">22</x:Double>

    <!-- 2. Floating Action Tray (Controls over stage, floating dialogs): 18px -->
    <CornerRadius x:Key="GlassRadiusFloatingTray">18</CornerRadius>
    <x:Double x:Key="GlassRadiusFloatingTrayDouble">18</x:Double>

    <!-- 3. Controls (Inputs, buttons, cards, containers): 10px -->
    <CornerRadius x:Key="GlassRadiusControl">10</CornerRadius>
    <x:Double x:Key="GlassRadiusControlDouble">10</x:Double>

    <!-- 4. Small Elements (Chips, badges, indicator tags, checkboxes): 6px -->
    <CornerRadius x:Key="GlassRadiusSmall">6</CornerRadius>
    <x:Double x:Key="GlassRadiusSmallDouble">6</x:Double>

    <!-- 5. Navigation Capsule & Pill Buttons: Fully round (999px) -->
    <CornerRadius x:Key="GlassRadiusCapsule">999</CornerRadius>
    <x:Double x:Key="GlassRadiusCapsuleDouble">999</x:Double>

    <!-- Backward Compatibility Radii Keys -->
    <CornerRadius x:Key="AppCornerRadiusCard">10</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusControl">10</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusButton">999</CornerRadius>
    <CornerRadius x:Key="GlassCornerRadiusCard">10</CornerRadius>
    <CornerRadius x:Key="GlassCornerRadiusControl">10</CornerRadius>
    <CornerRadius x:Key="GlassCornerRadiusPill">999</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">999</CornerRadius>

</ResourceDictionary>
