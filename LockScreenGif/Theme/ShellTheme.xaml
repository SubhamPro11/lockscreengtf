<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Theme/Colors.xaml" />
        <ResourceDictionary Source="/Theme/Radii.xaml" />
        <ResourceDictionary Source="/Theme/GlassMaterial.xaml" />
        <ResourceDictionary Source="/Theme/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 1. Floating Liquid Glass Navigation Capsule Tray Style -->
    <Style x:Key="GlassCapsuleNavTrayStyle" TargetType="Border">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="3,2,3,2" />
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassRimGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- 2. Restyled NavigationViewItem for the Capsule Navigation Bar -->
    <ControlTemplate x:Key="GlassCapsuleNavItemTemplate" TargetType="NavigationViewItem">
        <Grid x:Name="RootGrid" Height="30" Margin="1,0,1,0" UseLayoutRounding="True">
            <!-- Active / Hover Pill Background Surface -->
            <Border x:Name="PillSurface"
                    CornerRadius="15"
                    Background="Transparent"
                    BorderThickness="0">
                <Grid>
                    <!-- 1px Inner Top Highlight Stroke on Selected Ember Pill -->
                    <Border x:Name="InnerTopHighlight"
                            VerticalAlignment="Top"
                            Height="1"
                            Margin="4,0,4,0"
                            Background="#60FFFFFF"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <!-- Content Stack: Optical 16px Icon + Sentence Case Text -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Padding="12,0,12,0"
                                VerticalAlignment="Center">
                        <ContentPresenter x:Name="IconPresenter"
                                          Content="{TemplateBinding Icon}"
                                          Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                        <TextBlock x:Name="ContentText"
                                   Text="{TemplateBinding Content}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   UseLayoutRounding="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PillSurface.Background" Value="#14FFFFFF" />
                            <Setter Target="IconPresenter.Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
                            <Setter Target="ContentText.Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PillSurface.Background" Value="#1EFFFFFF" />
                            <Setter Target="PillSurface.Margin" Value="0,1,0,-1" />
                            <Setter Target="IconPresenter.Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
                            <Setter Target="ContentText.Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="IconPresenter.Opacity" Value="0.4" />
                            <Setter Target="ContentText.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="PillSurface.Background" Value="{StaticResource GlassEmberButtonNormalBrush}" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="1.0" />
                            <Setter Target="IconPresenter.Foreground" Value="#FFFFFF" />
                            <Setter Target="ContentText.Foreground" Value="#FFFFFF" />
                            <Setter Target="ContentText.FontWeight" Value="SemiBold" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SelectedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="PillSurface.Background" Value="{StaticResource GlassEmberButtonHoverBrush}" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="1.0" />
                            <Setter Target="IconPresenter.Foreground" Value="#FFFFFF" />
                            <Setter Target="ContentText.Foreground" Value="#FFFFFF" />
                            <Setter Target="ContentText.FontWeight" Value="SemiBold" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SelectedPressed">
                        <VisualState.Setters>
                            <Setter Target="PillSurface.Background" Value="{ThemeResource GlassEmberPressedBrush}" />
                            <Setter Target="PillSurface.Margin" Value="0,1,0,-1" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="0.25" />
                            <Setter Target="IconPresenter.Foreground" Value="#FFFFFF" />
                            <Setter Target="ContentText.Foreground" Value="#FFFFFF" />
                            <Setter Target="ContentText.FontWeight" Value="SemiBold" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="GlassCapsuleNavItemStyle" TargetType="NavigationViewItem">
        <Setter Property="Template" Value="{StaticResource GlassCapsuleNavItemTemplate}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="NavigationViewItem" BasedOn="{StaticResource GlassCapsuleNavItemStyle}" />

</ResourceDictionary>
