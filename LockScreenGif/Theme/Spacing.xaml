<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 4px Grid Spacing Primitives -->
    <x:Double x:Key="GlassSpacingXXS">4</x:Double>
    <x:Double x:Key="GlassSpacingXS">8</x:Double>
    <x:Double x:Key="GlassSpacingS">12</x:Double>
    <x:Double x:Key="GlassSpacingM">16</x:Double>
    <x:Double x:Key="GlassSpacingL">24</x:Double>
    <x:Double x:Key="GlassSpacingXL">32</x:Double>
    <x:Double x:Key="GlassSpacingXXL">40</x:Double>

    <!-- Semantic Rhythms -->
    <!-- Tight inside a group: 8px -->
    <x:Double x:Key="GlassGroupSpacingTight">8</x:Double>
    <!-- Standard element spacing: 16px -->
    <x:Double x:Key="GlassGroupSpacingStandard">16</x:Double>
    <!-- Generous between distinct groups: 32-40px -->
    <x:Double x:Key="GlassGroupSpacingGenerous">36</x:Double>

    <!-- Layout Dimensions -->
    <x:Double x:Key="GlassMaxContentWidth">1080</x:Double>
    <Thickness x:Key="GlassPagePadding">32,24,32,40</Thickness>
    <Thickness x:Key="GlassCardPadding">20,16,20,16</Thickness>
    <Thickness x:Key="GlassControlPadding">16,8,16,8</Thickness>
    <Thickness x:Key="GlassPillPadding">14,5,14,5</Thickness>

    <!-- Backward Compatibility Keys -->
    <x:Double x:Key="AppSpacingXXS">4</x:Double>
    <x:Double x:Key="AppSpacingXS">8</x:Double>
    <x:Double x:Key="AppSpacingS">12</x:Double>
    <x:Double x:Key="AppSpacingM">16</x:Double>
    <x:Double x:Key="AppSpacingL">24</x:Double>
    <x:Double x:Key="AppSpacingXL">32</x:Double>

    <Thickness x:Key="AppPageMargin">28,24,28,32</Thickness>
    <Thickness x:Key="AppMarginPage">28,24,28,32</Thickness>
    <x:Double x:Key="AppPageMaxWidth">1080</x:Double>
    <x:Double x:Key="AppCardSpacing">24</x:Double>
    <Thickness x:Key="AppPaddingCard">20,16,20,16</Thickness>
    <Thickness x:Key="AppPaddingCardElevated">20,16,20,16</Thickness>
    <Thickness x:Key="AppPaddingSection">28,24,28,24</Thickness>
    <Thickness x:Key="AppPaddingDialog">24,20,24,20</Thickness>
    <Thickness x:Key="AppPaddingButton">16,7,16,7</Thickness>
    <Thickness x:Key="AppPaddingPill">10,3,10,3</Thickness>
    <Thickness x:Key="AppSettingRowPadding">0,8,0,8</Thickness>
    <x:Double x:Key="AppSettingControlColumnWidth">240</x:Double>

    <!-- Layout Paddings & Margins for Navigation -->
    <Thickness x:Key="NavigationViewContentMargin">0,44,0,0</Thickness>
    <Thickness x:Key="NavigationViewHeaderMargin">32,16,0,0</Thickness>
    <Thickness x:Key="NavigationViewPageContentMargin">32,16,32,0</Thickness>

</ResourceDictionary>
