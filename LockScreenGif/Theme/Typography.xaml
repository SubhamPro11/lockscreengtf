<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font Families -->
    <FontFamily x:Key="GlassFontHeading">ms-appx:///Assets/Fonts/Fraunces.ttf#Fraunces, Georgia, serif</FontFamily>
    <FontFamily x:Key="GlassFontUI">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="GlassFontMonospace">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
    <FontFamily x:Key="InstrumentMonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Font Sizes Scale: 12 / 14 / 16 / 20 / 28 / 40 -->
    <x:Double x:Key="GlassFontSizeCaption">12</x:Double>
    <x:Double x:Key="GlassFontSizeBody">14</x:Double>
    <x:Double x:Key="GlassFontSizeSubhead">16</x:Double>
    <x:Double x:Key="GlassFontSizeSection">20</x:Double>
    <x:Double x:Key="GlassFontSizePageTitle">28</x:Double>
    <x:Double x:Key="GlassFontSizeHero">40</x:Double>

    <!-- Backward Compatibility Font Size Keys -->
    <x:Double x:Key="AppFontSizeCaption">12</x:Double>
    <x:Double x:Key="AppFontSizeReadout">12</x:Double>
    <x:Double x:Key="AppFontSizeBody">14</x:Double>
    <x:Double x:Key="AppFontSizeBodyStrong">14</x:Double>
    <x:Double x:Key="MediumFontSize">16</x:Double>
    <x:Double x:Key="AppFontSizeSubtitle">18</x:Double>
    <x:Double x:Key="LargeFontSize">24</x:Double>
    <x:Double x:Key="AppFontSizeTitle">28</x:Double>

    <!-- Typography Styles -->

    <!-- Page Title: Fraunces, 28px, 600 weight, Sentence case -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontHeading}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="AppPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}" />

    <!-- Hero / Live Lockscreen Clock: Fraunces, 40px, 600 weight, Tabular figures -->
    <Style x:Key="HeroClockTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontHeading}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizeHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Section Title: Segoe UI Variable, 20px, 600 weight -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontUI}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}" />

    <!-- Setting Title / Item Heading: Segoe UI Variable, 14px, 600 weight -->
    <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontUI}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Setting Description / Helper text: Segoe UI Variable, 12px, 400 weight -->
    <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontUI}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Standard Body Text: Segoe UI Variable, 14px, 400 weight -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontUI}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Monospace Technical / Telemetry Readout: Cascadia Mono, 12px, Tabular figures -->
    <Style x:Key="GlassReadoutTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontMonospace}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="InstrumentReadoutTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GlassReadoutTextStyle}" />

</ResourceDictionary>
