<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Theme/Colors.xaml" />
        <ResourceDictionary Source="/Theme/Radii.xaml" />
        <ResourceDictionary Source="/Theme/GlassMaterial.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Primary Ember Button Gradient Brushes (6% Vertical Shift: #ED553E to #E8452C) -->
    <LinearGradientBrush x:Key="GlassEmberButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ED553E" Offset="0.0" />
        <GradientStop Color="#E8452C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassEmberButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4624C" Offset="0.0" />
        <GradientStop Color="#ED553E" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassDestructiveButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ED5555" Offset="0.0" />
        <GradientStop Color="#E5484D" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 1. Primary Button Template (Solid Ember, 1px inner top highlight, 6% shift, sinks 1px on press, flat Raised on disabled) -->
    <ControlTemplate x:Key="GlassPrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" Background="Transparent">
            <!-- Outer Button Surface -->
            <Border x:Name="OuterBorder"
                    Background="{StaticResource GlassEmberButtonNormalBrush}"
                    BorderBrush="#26000000"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                    <!-- 1px Inner Top Highlight Stroke (White 30%) -->
                    <Border x:Name="InnerTopHighlight"
                            VerticalAlignment="Top"
                            Height="1"
                            Margin="2,0,2,0"
                            Background="#50FFFFFF"
                            IsHitTestVisible="False" />

                    <!-- Content Presenter -->
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="#FFFFFF"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      FontSize="{TemplateBinding FontSize}"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="{StaticResource GlassEmberButtonHoverBrush}" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="{ThemeResource GlassEmberPressedBrush}" />
                            <Setter Target="OuterBorder.Margin" Value="0,1,0,-1" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="0.2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="{ThemeResource GlassRaisedBrush}" />
                            <Setter Target="OuterBorder.BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="0.0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- 2. Glass Button Template (Liquid Glass material, 1px rim light, inner stroke, sinks 1px on press, flat Raised on disabled) -->
    <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" Background="Transparent">
            <!-- Glass Outer Frame & Rim Light -->
            <Border x:Name="GlassFrame"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource GlassRimGradientBrush}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                    <!-- 1px Inner Rim Highlight -->
                    <Border x:Name="InnerRim"
                            Margin="1"
                            BorderBrush="{StaticResource GlassInnerRimBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                    <!-- Faint Top Sheen (Top 40%) -->
                    <Border x:Name="TopSheen"
                            VerticalAlignment="Top"
                            Height="14"
                            Margin="2,1,2,0"
                            Background="{StaticResource GlassSheenBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                    <!-- Content Presenter -->
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      FontSize="{TemplateBinding FontSize}"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="GlassFrame.BorderBrush" Value="{StaticResource GlassHoverRimGradientBrush}" />
                            <Setter Target="GlassFrame.Background" Value="#24FFFFFF" />
                            <Setter Target="TopSheen.Opacity" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="GlassFrame.Background" Value="#10FFFFFF" />
                            <Setter Target="GlassFrame.Margin" Value="0,1,0,-1" />
                            <Setter Target="TopSheen.Opacity" Value="0.3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="GlassFrame.Background" Value="{ThemeResource GlassRaisedBrush}" />
                            <Setter Target="GlassFrame.BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                            <Setter Target="InnerRim.Opacity" Value="0.0" />
                            <Setter Target="TopSheen.Opacity" Value="0.0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- 3. Quiet / Subtle Button Template (Text only with subtle hover fill, sinks 1px on press) -->
    <ControlTemplate x:Key="GlassSubtleButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" Background="Transparent">
            <Border x:Name="ButtonSurface"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter x:Name="ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Foreground="{TemplateBinding Foreground}"
                                  FontWeight="{TemplateBinding FontWeight}"
                                  FontSize="{TemplateBinding FontSize}"
                                  AutomationProperties.AccessibilityView="Raw" />
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="ButtonSurface.Background" Value="#12FFFFFF" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="ButtonSurface.Background" Value="#1EFFFFFF" />
                            <Setter Target="ButtonSurface.Margin" Value="0,1,0,-1" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextTertiaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- 4. Destructive Button Template -->
    <ControlTemplate x:Key="GlassDestructiveButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" Background="Transparent">
            <Border x:Name="OuterBorder"
                    Background="{StaticResource GlassDestructiveButtonNormalBrush}"
                    BorderBrush="#26000000"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                    <Border x:Name="InnerTopHighlight" VerticalAlignment="Top" Height="1" Margin="2,0,2,0" Background="#50FFFFFF" IsHitTestVisible="False" />
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="#FFFFFF"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      FontSize="{TemplateBinding FontSize}"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="#F25B5B" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="#C93439" />
                            <Setter Target="OuterBorder.Margin" Value="0,1,0,-1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="{ThemeResource GlassRaisedBrush}" />
                            <Setter Target="OuterBorder.BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="0.0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- Button Styles -->
    <Style x:Key="GlassPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource GlassPrimaryButtonTemplate}" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusCapsule}" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
        <Setter Property="Background" Value="#16FFFFFF" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusCapsule}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="GlassSubtleButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource GlassSubtleButtonTemplate}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusControl}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="GlassDestructiveButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource GlassDestructiveButtonTemplate}" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusCapsule}" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassDestructiveButtonStyle}" />

    <Style x:Key="StepperButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassSubtleButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="GlassHyperlinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource GlassEmberHoverBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}" />

    <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource GlassSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
    </Style>

    <Style x:Key="GlassComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource GlassSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
    </Style>

    <Style x:Key="GlassSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{ThemeResource GlassEmberBrush}" />
    </Style>

    <Style x:Key="GlassToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="On" />
        <Setter Property="OffContent" Value="Off" />
    </Style>

    <Style x:Key="GlassProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource GlassEmberBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="4" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource GlassComboBoxStyle}" />
    <Style TargetType="Slider" BasedOn="{StaticResource GlassSliderStyle}" />
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource GlassToggleSwitchStyle}" />
    <Style TargetType="ProgressBar" BasedOn="{StaticResource GlassProgressBarStyle}" />

</ResourceDictionary>
