<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Dark / Default Theme -->
        <ResourceDictionary x:Key="Default">
            <!-- Neutral Windows 11 Surfaces (Layered over Mica) -->
            <SolidColorBrush x:Key="GlassSurfaceBaseBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="GlassSurfaceElevatedBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="GlassSurfaceSolidFallbackBrush" Color="#202020" />

            <!-- Clean Windows 11 1px Border Stroke -->
            <SolidColorBrush x:Key="GlassBorderRimBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlassBorderSolidFallbackBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="GlassInnerHighlightBrush" Color="Transparent" />

            <!-- Typography & Content -->
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="GlassTextMonospaceBrush" Color="#99FFFFFF" />

            <!-- Single System Accent Color & Status -->
            <SolidColorBrush x:Key="GlassAccentBrassBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassHoverBrush" Color="{ThemeResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="GlassAccentBrassPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="GlassStatusSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="GlassStatusAlertBrush" Color="#FF99A4" />

            <!-- WinUI Control Overrides -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{ThemeResource SystemAccentColor}" />

            <!-- NavigationView Styling -->
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#99FFFFFF" />

            <!-- Dialogs, Flyouts & Overlays -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#E5202020" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#80000000" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#E5202020" />
            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#E5202020" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#E5202020" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />

            <!-- Accessible Focus Visuals -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#000000" />

            <!-- Backward compatibility aliases -->
            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="#282828" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="#FF99A4" />
        </ResourceDictionary>

        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <!-- Neutral Windows 11 Surfaces (Layered over Mica) -->
            <SolidColorBrush x:Key="GlassSurfaceBaseBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="GlassSurfaceElevatedBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="#06000000" />
            <SolidColorBrush x:Key="GlassSurfaceSolidFallbackBrush" Color="#F3F3F3" />

            <!-- Clean Windows 11 1px Border Stroke -->
            <SolidColorBrush x:Key="GlassBorderRimBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="GlassBorderSolidFallbackBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="GlassInnerHighlightBrush" Color="Transparent" />

            <!-- Typography & Content -->
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="GlassTextMonospaceBrush" Color="#9E000000" />

            <!-- Single System Accent Color & Status -->
            <SolidColorBrush x:Key="GlassAccentBrassBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassHoverBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="GlassAccentBrassPressedBrush" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="GlassStatusSuccessBrush" Color="#107C10" />
            <SolidColorBrush x:Key="GlassStatusAlertBrush" Color="#C42B1C" />

            <!-- WinUI Control Overrides -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{ThemeResource SystemAccentColor}" />

            <!-- NavigationView Styling -->
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#0A000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#06000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#10000000" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#9E000000" />

            <!-- Dialogs, Flyouts & Overlays -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#40000000" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#E4000000" />

            <!-- Accessible Focus Visuals -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFFFFF" />

            <!-- Backward compatibility aliases -->
            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="#107C10" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="#C42B1C" />
        </ResourceDictionary>

        <!-- High Contrast Theme -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GlassSurfaceBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassSurfaceSolidFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="GlassBorderRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassBorderSolidFallbackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassInnerHighlightBrush" Color="Transparent" />

            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTextMonospaceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="GlassAccentBrassBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassStatusSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassStatusAlertBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#CC000000" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Typography & Geometry -->
    <FontFamily x:Key="GlassFontMonospace">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="InstrumentMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Exactly Two Corner Radii Across System -->
    <CornerRadius x:Key="AppCornerRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="GlassCornerRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="GlassCornerRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="GlassCornerRadiusPill">4</CornerRadius>

    <!-- Native Windows 11 Card Surfaces -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassSurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusCard}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="GlassCardElevatedStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusCard}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="GlassPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="InstrumentCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}" />

    <!-- Native Windows 11 Buttons -->
    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GlassSurfaceSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="GlassRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="{ThemeResource GlassSurfaceSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="GlassPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GlassAccentBrassBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="GlassSubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Standard Windows 11 Inputs -->
    <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
    </Style>

    <Style x:Key="GlassComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusControl}" />
    </Style>

    <Style x:Key="GlassSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{ThemeResource GlassAccentBrassBrush}" />
    </Style>

    <Style x:Key="GlassToggleSwitchStyle" TargetType="ToggleSwitch" />

    <Style x:Key="GlassProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource GlassAccentBrassBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="4" />
    </Style>

    <!-- Clean Monospace Telemetry / Readout -->
    <Style x:Key="GlassReadoutTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontMonospace}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
    </Style>

    <Style x:Key="InstrumentReadoutTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GlassReadoutTextStyle}" />

</ResourceDictionary>
