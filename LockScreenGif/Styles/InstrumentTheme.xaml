    <!-- Control Templates -->
    <!-- 1. Primary Button Template -->
    <ControlTemplate x:Key="GlassPrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" Background="Transparent">
            <Border x:Name="OuterBorder"
                    Background="{StaticResource GlassEmberButtonNormalBrush}"
                    BorderBrush="#26000000"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                    <Border x:Name="InnerTopHighlight"
                            VerticalAlignment="Top"
                            Height="1"
                            Margin="2,0,2,0"
                            Background="#50FFFFFF"
                            IsHitTestVisible="False" />

                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="#FFFFFF"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      FontSize="{TemplateBinding FontSize}"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="{StaticResource GlassEmberButtonHoverBrush}" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="{ThemeResource GlassEmberPressedBrush}" />
                            <Setter Target="OuterBorder.Margin" Value="0,1,0,-1" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="0.2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="OuterBorder.Background" Value="{ThemeResource GlassRaisedBrush}" />
                            <Setter Target="OuterBorder.BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                            <Setter Target="InnerTopHighlight.Opacity" Value="0.0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- 2. Glass Button Template -->
    <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" Background="Transparent">
            <Border x:Name="GlassFrame"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource GlassRimGradientBrush}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                    <Border x:Name="InnerRim"
                            Margin="1"
                            BorderBrush="{StaticResource GlassInnerRimBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="TopSheen"
                            VerticalAlignment="Top"
                            Height="14"
                            Margin="2,1,2,0"
                            Background="{StaticResource GlassSheenBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      FontSize="{TemplateBinding FontSize}"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="GlassFrame.BorderBrush" Value="{StaticResource GlassHoverRimGradientBrush}" />
                            <Setter Target="GlassFrame.Background" Value="#24FFFFFF" />
                            <Setter Target="TopSheen.Opacity" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="GlassFrame.Background" Value="#10FFFFFF" />
                            <Setter Target="GlassFrame.Margin" Value="0,1,0,-1" />
                            <Setter Target="TopSheen.Opacity" Value="0.3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="GlassFrame.Background" Value="{ThemeResource GlassRaisedBrush}" />
                            <Setter Target="GlassFrame.BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                            <Setter Target="InnerRim.Opacity" Value="0.0" />
                            <Setter Target="TopSheen.Opacity" Value="0.0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- 3. Quiet / Subtle Button Template -->
    <ControlTemplate x:Key="GlassSubtleButtonTemplate" TargetType="Button">
