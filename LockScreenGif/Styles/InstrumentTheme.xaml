    <Style x:Key="GlassToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <Style x:Key="GlassProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource GlassPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="4" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource GlassComboBoxStyle}" />
    <Style TargetType="Slider" BasedOn="{StaticResource GlassSliderStyle}" />
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource GlassToggleSwitchStyle}" />
    <Style TargetType="ProgressBar" BasedOn="{StaticResource GlassProgressBarStyle}" />

    <!-- ContentDialog Style -->
    <Style TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="{StaticResource ContentDialogCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource GlassRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource MaterialFilledButtonStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource MaterialTonalButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource MaterialTextButtonStyle}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Flyout & MenuFlyout Styles -->
    <Style TargetType="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource FlyoutCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource GlassRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource FlyoutCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource GlassRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ToolTip Style -->
    <Style TargetType="ToolTip">
        <Setter Property="CornerRadius" Value="{StaticResource ToolTipCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource GlassRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- InfoBar Style -->
    <Style TargetType="InfoBar">
        <Setter Property="CornerRadius" Value="{StaticResource InfoBarCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource GlassRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Shell Theme: Floating Navigation Capsule Tray Style -->
    <Style x:Key="GlassCapsuleNavTrayStyle" TargetType="Border">
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{ThemeResource GlassSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Shell Theme: Capsule Navigation Bar Style -->
    <Style x:Key="GlassCapsuleNavItemStyle" TargetType="NavigationViewItem">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="NavigationViewItem" BasedOn="{StaticResource GlassCapsuleNavItemStyle}" />

</ResourceDictionary>
