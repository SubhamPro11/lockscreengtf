<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Dark / Default Theme (The Projection Booth: Warm dark neutrals with Ember accent) -->
        <ResourceDictionary x:Key="Default">
            <!-- Surface Colors -->
            <Color x:Key="GlassBaseColor">#121110</Color>
            <Color x:Key="GlassRaisedColor">#1A1917</Color>
            <Color x:Key="GlassSubtleColor">#22201D</Color>
            <Color x:Key="GlassHairlineColor">#14FFF4E6</Color>

            <SolidColorBrush x:Key="GlassBaseBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="GlassRaisedBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassSubtleBrush" Color="{StaticResource GlassSubtleColor}" />
            <SolidColorBrush x:Key="GlassHairlineBrush" Color="{StaticResource GlassHairlineColor}" />

            <!-- Backward compatibility aliases for existing pages -->
            <SolidColorBrush x:Key="GlassSurfaceBaseBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="GlassSurfaceElevatedBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="{StaticResource GlassSubtleColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSolidFallbackBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassBorderRimBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassBorderSolidFallbackBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassBorderAccentBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassInnerHighlightBrush" Color="#0DFFFFFF" />

            <!-- Typography & Foreground -->
            <Color x:Key="GlassTextPrimaryColor">#F3EEE7</Color>
            <Color x:Key="GlassTextSecondaryColor">#B5ADA2</Color>
            <Color x:Key="GlassTextTertiaryColor">#8A8277</Color>

            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{StaticResource GlassTextSecondaryColor}" />
            <SolidColorBrush x:Key="GlassTextTertiaryBrush" Color="{StaticResource GlassTextTertiaryColor}" />
            <SolidColorBrush x:Key="GlassTextMonospaceBrush" Color="{StaticResource GlassTextSecondaryColor}" />

            <!-- Accent & Functional Colors: Ember (#E8452C) -->
            <Color x:Key="GlassEmberColor">#E8452C</Color>
            <Color x:Key="GlassEmberPressedColor">#C8351F</Color>
            <Color x:Key="GlassEmberHoverColor">#FF6A4D</Color>

            <SolidColorBrush x:Key="GlassEmberBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="GlassEmberPressedBrush" Color="{StaticResource GlassEmberPressedColor}" />
            <SolidColorBrush x:Key="GlassEmberHoverBrush" Color="{StaticResource GlassEmberHoverColor}" />

            <!-- Functional Status -->
            <SolidColorBrush x:Key="GlassStatusSuccessBrush" Color="#6FBF8A" />
            <SolidColorBrush x:Key="GlassStatusWarningBrush" Color="#E0B04A" />
            <SolidColorBrush x:Key="GlassStatusAlertBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="GlassDestructiveButtonBrush" Color="#E5484D" />

            <!-- Compatibility aliases for older views -->
            <SolidColorBrush x:Key="GlassAccentBrassBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassHoverBrush" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassPressedBrush" Color="{StaticResource GlassEmberPressedColor}" />

            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="{StaticResource GlassTextSecondaryColor}" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="#6FBF8A" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="#E5484D" />

            <!-- WinUI Control Colors Overrides -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource GlassEmberPressedColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource GlassEmberColor}" />

            <!-- Navigation Bar Colors -->
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource GlassTextSecondaryColor}" />

            <!-- Accessible Focus Visuals: 2px Ember with 1px inner dark separation -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource GlassBaseColor}" />

            <!-- Overlays, Flyouts & Dialogs -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#E51A1917" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#8C000000" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#E51A1917" />
            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#E51A1917" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#E51A1917" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource GlassTextPrimaryBrush}" />

            <!-- WinUI 3 AcrylicBrush (In-app acrylic with Base tint and 65% opacity) -->
            <AcrylicBrush x:Key="GlassBackdropBrush"
                          TintColor="#121110"
                          TintOpacity="0.65"
                          FallbackColor="#1A1917" />

            <SolidColorBrush x:Key="GlassSolidSurfaceBrush" Color="#1A1917" />
            <SolidColorBrush x:Key="GlassSolidBorderBrush" Color="#14FFF4E6" />
        </ResourceDictionary>

        <!-- Light Theme: Clean warm neutrals -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="GlassBaseColor">#F7F5F2</Color>
            <Color x:Key="GlassRaisedColor">#FFFFFF</Color>
            <Color x:Key="GlassSubtleColor">#EFECE6</Color>
            <Color x:Key="GlassHairlineColor">#141C1917</Color>

            <SolidColorBrush x:Key="GlassBaseBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="GlassRaisedBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassSubtleBrush" Color="{StaticResource GlassSubtleColor}" />
            <SolidColorBrush x:Key="GlassHairlineBrush" Color="{StaticResource GlassHairlineColor}" />

            <SolidColorBrush x:Key="GlassSurfaceBaseBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="GlassSurfaceElevatedBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="{StaticResource GlassSubtleColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSolidFallbackBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassBorderRimBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassBorderSolidFallbackBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassBorderAccentBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassInnerHighlightBrush" Color="#0D000000" />

            <Color x:Key="GlassTextPrimaryColor">#1C1917</Color>
            <Color x:Key="GlassTextSecondaryColor">#6E665E</Color>
            <Color x:Key="GlassTextTertiaryColor">#9E9589</Color>

            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{StaticResource GlassTextSecondaryColor}" />
            <SolidColorBrush x:Key="GlassTextTertiaryBrush" Color="{StaticResource GlassTextTertiaryColor}" />
            <SolidColorBrush x:Key="GlassTextMonospaceBrush" Color="{StaticResource GlassTextSecondaryColor}" />

            <Color x:Key="GlassEmberColor">#D83A22</Color>
            <Color x:Key="GlassEmberPressedColor">#B82E18</Color>
            <Color x:Key="GlassEmberHoverColor">#FF5738</Color>

            <SolidColorBrush x:Key="GlassEmberBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="GlassEmberPressedBrush" Color="{StaticResource GlassEmberPressedColor}" />
            <SolidColorBrush x:Key="GlassEmberHoverBrush" Color="{StaticResource GlassEmberHoverColor}" />

            <SolidColorBrush x:Key="GlassStatusSuccessBrush" Color="#1E8E4D" />
            <SolidColorBrush x:Key="GlassStatusWarningBrush" Color="#B57E12" />
            <SolidColorBrush x:Key="GlassStatusAlertBrush" Color="#D63939" />
            <SolidColorBrush x:Key="GlassDestructiveButtonBrush" Color="#D63939" />

            <SolidColorBrush x:Key="GlassAccentBrassBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassHoverBrush" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassPressedBrush" Color="{StaticResource GlassEmberPressedColor}" />

            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="{StaticResource GlassTextSecondaryColor}" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="#1E8E4D" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="#D63939" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource GlassEmberPressedColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource GlassEmberColor}" />

            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#10000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#08000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#16000000" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource GlassTextSecondaryColor}" />

            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#50000000" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource GlassTextPrimaryColor}" />

            <AcrylicBrush x:Key="GlassBackdropBrush"
                          TintColor="#F7F5F2"
                          TintOpacity="0.75"
                          FallbackColor="#FFFFFF" />

            <SolidColorBrush x:Key="GlassSolidSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GlassSolidBorderBrush" Color="#141C1917" />
        </ResourceDictionary>

        <!-- High Contrast Theme -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GlassBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSubtleBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="GlassSurfaceBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassSurfaceSolidFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassBorderRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassBorderSolidFallbackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassBorderAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassInnerHighlightBrush" Color="Transparent" />

            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTextMonospaceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="GlassEmberBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassEmberPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassEmberHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassStatusSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassStatusWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassStatusAlertBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="GlassDestructiveButtonBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <SolidColorBrush x:Key="GlassAccentBrassBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#CC000000" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="GlassBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSolidSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSolidBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Focus Visual Dimensions (2px Ember outer ring with 1px inner ring) -->
    <Thickness x:Key="FocusVisualPrimaryThickness">2</Thickness>
    <Thickness x:Key="FocusVisualSecondaryThickness">1</Thickness>

    <!-- Specular Sheen (Faint Linear Gradient over Top 40%: White 6% to 0%) -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0FFFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Liquid Glass Rim Light (1px outer stroke: top-left ~35%, middle ~4%, bottom-right ~14%) -->
    <LinearGradientBrush x:Key="GlassRimGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59FFFFFF" Offset="0.0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.45" />
        <GradientStop Color="#24FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Hover Rim Light (Brightens on pointer hover) -->
    <LinearGradientBrush x:Key="GlassHoverRimGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8CFFFFFF" Offset="0.0" />
        <GradientStop Color="#18FFFFFF" Offset="0.45" />
        <GradientStop Color="#40FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Inner Stroke: 1px inner edge thickness at ~5% white -->
    <SolidColorBrush x:Key="GlassInnerRimBrush" Color="#0DFFFFFF" />

    <!-- 1. Flat Raised Card Style -->
    <Style x:Key="FlatRaisedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusControl}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- 2. Floating Action Tray Style -->
    <Style x:Key="GlassFloatingTrayStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassRimGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusFloatingTray}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- 3. Navigation Capsule Style -->
    <Style x:Key="GlassNavCapsuleStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassRimGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusCapsule}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- 4. Glass Dialog & Overlay Style -->
    <Style x:Key="GlassDialogStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassRimGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusFloatingTray}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Backward Compatibility Surface Styles -->
    <Style x:Key="GlassCardStyle" TargetType="Border" BasedOn="{StaticResource FlatRaisedCardStyle}" />
    <Style x:Key="GlassCardElevatedStyle" TargetType="Border" BasedOn="{StaticResource FlatRaisedCardStyle}" />
    <Style x:Key="InstrumentCardStyle" TargetType="Border" BasedOn="{StaticResource FlatRaisedCardStyle}" />

    <Style x:Key="GlassPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Font Families (Native Windows 11 optical sizes) -->
    <FontFamily x:Key="GlassFontHeading">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="GlassFontDisplay">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="GlassFontUI">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="GlassFontUi">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="GlassFontMonospace">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
    <FontFamily x:Key="InstrumentMonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Font Sizes Scale: 12 / 14 / 16 / 20 / 28 / 40 -->
    <x:Double x:Key="GlassFontSizeCaption">12</x:Double>
    <x:Double x:Key="GlassFontSizeBody">14</x:Double>
    <x:Double x:Key="GlassFontSizeSubhead">16</x:Double>
    <x:Double x:Key="GlassFontSizeSection">20</x:Double>
    <x:Double x:Key="GlassFontSizePageTitle">28</x:Double>
    <x:Double x:Key="GlassFontSizeHero">40</x:Double>

    <!-- Backward Compatibility Font Size Keys -->
    <x:Double x:Key="AppFontSizeCaption">12</x:Double>
    <x:Double x:Key="AppFontSizeReadout">12</x:Double>
    <x:Double x:Key="AppFontSizeBody">14</x:Double>
    <x:Double x:Key="AppFontSizeBodyStrong">14</x:Double>
    <x:Double x:Key="MediumFontSize">16</x:Double>
    <x:Double x:Key="AppFontSizeSubtitle">18</x:Double>
    <x:Double x:Key="LargeFontSize">24</x:Double>
    <x:Double x:Key="AppFontSizeTitle">28</x:Double>

    <!-- Typography Styles -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontHeading}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="AppPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}" />

    <Style x:Key="HeroClockTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontHeading}" />
        <Setter Property="FontSize" Value="{StaticResource GlassFontSizeHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

