    <!-- Focus Visual Dimensions -->
    <Thickness x:Key="FocusVisualPrimaryThickness">2</Thickness>
    <Thickness x:Key="FocusVisualSecondaryThickness">1</Thickness>

    <!-- Gradient Rims and Overlays -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0FFFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassRimGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33FFA79B" Offset="0.0" />
        <GradientStop Color="#0A534341" Offset="0.45" />
        <GradientStop Color="#24534341" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassHoverRimGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFA79B" Offset="0.0" />
        <GradientStop Color="#18FFA79B" Offset="0.45" />
        <GradientStop Color="#40534341" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassInnerRimBrush" Color="#0DFFFFFF" />

    <!-- 1. Flat Raised Card Style -->
    <Style x:Key="FlatRaisedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusControl}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- 2. Floating Action Tray Style -->
    <Style x:Key="GlassFloatingTrayStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusFloatingTray}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- 3. Navigation Capsule Style -->
    <Style x:Key="GlassNavCapsuleStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource GlassRadiusCapsule}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- 4. Glass Dialog & Overlay Style -->
    <Style x:Key="GlassDialogStyle" TargetType="Border">
