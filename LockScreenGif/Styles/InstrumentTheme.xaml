<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="#15171a" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="#1c1f23" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="#30343a" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="#d9d4c7" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="#8d8f8a" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="#c9a66b" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="#7f9a8a" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="#cf6679" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="#f4f3ef" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="#eae7df" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="#d1cdc2" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="#1c1f23" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="#686a64" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="#967032" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="#4d6858" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="#b00020" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="InstrumentMonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

    <Style x:Key="InstrumentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InstrumentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource InstrumentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="InstrumentReadoutTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InstrumentMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource InstrumentGaugeGreenBrush}" />
    </Style>

</ResourceDictionary>

