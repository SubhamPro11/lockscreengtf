<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Dark / Default Theme (Material 3 Red Dark System) -->
        <ResourceDictionary x:Key="Default">
            <!-- Surface Colors -->
            <Color x:Key="GlassBaseColor">#1A1110</Color>
            <Color x:Key="GlassRaisedColor">#221816</Color>
            <Color x:Key="GlassSubtleColor">#2C211F</Color>
            <Color x:Key="GlassHairlineColor">#534341</Color>

            <SolidColorBrush x:Key="GlassBaseBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="GlassRaisedBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassSubtleBrush" Color="{StaticResource GlassSubtleColor}" />
            <SolidColorBrush x:Key="GlassHairlineBrush" Color="{StaticResource GlassHairlineColor}" />

            <!-- Material 3 Red Dark Core Tokens -->
            <Color x:Key="GlassPrimaryColor">#FFA79B</Color>
            <Color x:Key="GlassOnPrimaryColor">#561E18</Color>
            <Color x:Key="GlassSecondaryContainerColor">#5D3F3B</Color>
            <Color x:Key="GlassOnSecondaryContainerColor">#FFDAD5</Color>
            <Color x:Key="GlassOutlineVariantColor">#534341</Color>

            <SolidColorBrush x:Key="GlassPrimaryBrush" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="GlassOnPrimaryBrush" Color="{StaticResource GlassOnPrimaryColor}" />
            <SolidColorBrush x:Key="GlassSecondaryContainerBrush" Color="{StaticResource GlassSecondaryContainerColor}" />
            <SolidColorBrush x:Key="GlassOnSecondaryContainerBrush" Color="{StaticResource GlassOnSecondaryContainerColor}" />
            <SolidColorBrush x:Key="GlassOutlineVariantBrush" Color="{StaticResource GlassOutlineVariantColor}" />

            <!-- Backward compatibility aliases for existing pages -->
            <SolidColorBrush x:Key="GlassSurfaceBaseBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="GlassSurfaceElevatedBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="{StaticResource GlassSubtleColor}" />
            <SolidColorBrush x:Key="GlassSurfaceSolidFallbackBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="GlassBorderRimBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassBorderSolidFallbackBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassBorderAccentBrush" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="GlassInnerHighlightBrush" Color="#0DFFFFFF" />

            <!-- Typography & Foreground (On Surface & On Surface Variant) -->
            <Color x:Key="GlassTextPrimaryColor">#F1DEDC</Color>
            <Color x:Key="GlassTextSecondaryColor">#D8C2BE</Color>
            <Color x:Key="GlassTextTertiaryColor">#A4928F</Color>

            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{StaticResource GlassTextSecondaryColor}" />
            <SolidColorBrush x:Key="GlassTextTertiaryBrush" Color="{StaticResource GlassTextTertiaryColor}" />
            <SolidColorBrush x:Key="GlassTextMonospaceBrush" Color="{StaticResource GlassTextSecondaryColor}" />

            <!-- Accent & Functional Colors: Coral Primary (#FFA79B) -->
            <Color x:Key="GlassEmberColor">#FFA79B</Color>
            <Color x:Key="GlassEmberPressedColor">#FF8C7C</Color>
            <Color x:Key="GlassEmberHoverColor">#FFB5AB</Color>

            <SolidColorBrush x:Key="GlassEmberBrush" Color="{StaticResource GlassEmberColor}" />
            <SolidColorBrush x:Key="GlassEmberPressedBrush" Color="{StaticResource GlassEmberPressedColor}" />
            <SolidColorBrush x:Key="GlassEmberHoverBrush" Color="{StaticResource GlassEmberHoverColor}" />

            <!-- Functional Status -->
            <SolidColorBrush x:Key="GlassStatusSuccessBrush" Color="#7FD99F" />
            <SolidColorBrush x:Key="GlassStatusWarningBrush" Color="#FFB951" />
            <SolidColorBrush x:Key="GlassStatusAlertBrush" Color="#FF897D" />
            <SolidColorBrush x:Key="GlassDestructiveButtonBrush" Color="#FF897D" />

            <!-- Compatibility aliases for older views -->
            <SolidColorBrush x:Key="GlassAccentBrassBrush" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassHoverBrush" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="GlassAccentBrassPressedBrush" Color="{StaticResource GlassEmberPressedColor}" />

            <SolidColorBrush x:Key="InstrumentBackgroundBrush" Color="{StaticResource GlassBaseColor}" />
            <SolidColorBrush x:Key="InstrumentSurfaceBrush" Color="{StaticResource GlassRaisedColor}" />
            <SolidColorBrush x:Key="InstrumentBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="InstrumentTextPrimaryBrush" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="InstrumentTextMutedBrush" Color="{StaticResource GlassTextSecondaryColor}" />
            <SolidColorBrush x:Key="InstrumentAccentBrassBrush" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="InstrumentGaugeGreenBrush" Color="#7FD99F" />
            <SolidColorBrush x:Key="InstrumentAlertRedBrush" Color="#FF897D" />

            <!-- WinUI Control Colors Overrides -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource GlassEmberPressedColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource GlassEmberHoverColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource GlassPrimaryColor}" />

            <!-- Navigation Bar Colors: Secondary Container Pill for Selected Tab -->
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource GlassSecondaryContainerColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#6B4A45" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#503532" />

            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource GlassTextSecondaryColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{StaticResource GlassTextPrimaryColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource GlassOnSecondaryContainerColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{StaticResource GlassOnSecondaryContainerColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{StaticResource GlassOnSecondaryContainerColor}" />

            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

            <!-- Accessible Focus Visuals: 2px Primary with 1px inner dark separation -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource GlassBaseColor}" />

            <!-- Overlays, Flyouts & Dialogs -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#F2221816" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#A6000000" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F2221816" />
            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F2221816" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#F2221816" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource GlassHairlineColor}" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource GlassTextPrimaryColor}" />

            <!-- WinUI 3 AcrylicBrush (In-app acrylic with Base tint and 65% opacity) -->
            <AcrylicBrush x:Key="GlassBackdropBrush"
                          TintColor="#1A1110"
                          TintOpacity="0.75"
                          FallbackColor="#221816" />

            <SolidColorBrush x:Key="GlassSolidSurfaceBrush" Color="#221816" />
            <SolidColorBrush x:Key="GlassSolidBorderBrush" Color="#534341" />

            <LinearGradientBrush x:Key="GlassTopVignetteBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#501A1110" Offset="0.0" />
                <GradientStop Color="#001A1110" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- Light Theme: Clean warm neutrals -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="GlassBaseColor">#FFF8F6</Color>
            <Color x:Key="GlassRaisedColor">#FFFFFF</Color>
            <Color x:Key="GlassSubtleColor">#F5ECE9</Color>
