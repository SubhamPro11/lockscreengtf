<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 4/8px Spacing Scale Primitives -->
    <x:Double x:Key="AppSpacingXXS">4</x:Double>
    <x:Double x:Key="AppSpacingXS">8</x:Double>
    <x:Double x:Key="AppSpacingS">12</x:Double>
    <x:Double x:Key="AppSpacingM">16</x:Double>
    <x:Double x:Key="AppSpacingL">24</x:Double>
    <x:Double x:Key="AppSpacingXL">32</x:Double>

    <!-- Semantic Padding and Margins -->
    <Thickness x:Key="AppPaddingCard">16,16,16,16</Thickness>
    <Thickness x:Key="AppPaddingCardElevated">20,20,20,20</Thickness>
    <Thickness x:Key="AppPaddingSection">24,20,24,24</Thickness>
    <Thickness x:Key="AppPaddingDialog">24,20,24,20</Thickness>
    <Thickness x:Key="AppPaddingButton">16,6,16,6</Thickness>
    <Thickness x:Key="AppPaddingPill">8,3,8,3</Thickness>

    <!-- Backward-compatible Thickness definitions -->
    <Thickness x:Key="LargeTopMargin">0,32,0,0</Thickness>
    <Thickness x:Key="LargeTopBottomMargin">0,32,0,32</Thickness>

    <Thickness x:Key="MediumTopMargin">0,24,0,0</Thickness>
    <Thickness x:Key="MediumTopBottomMargin">0,24,0,24</Thickness>
    <Thickness x:Key="MediumLeftRightMargin">24,0,24,0</Thickness>
    <Thickness x:Key="MediumBottomMargin">0,0,0,24</Thickness>

    <Thickness x:Key="SmallLeftMargin">12,0,0,0</Thickness>
    <Thickness x:Key="SmallLeftRightMargin">12,0,12,0</Thickness>
    <Thickness x:Key="SmallTopMargin">0,12,0,0</Thickness>
    <Thickness x:Key="SmallRightMargin">0,0,12,0</Thickness>
    <Thickness x:Key="SmallTopBottomMargin">0,12,0,12</Thickness>

    <Thickness x:Key="XSmallLeftMargin">8,0,0,0</Thickness>
    <Thickness x:Key="XSmallTopMargin">0,8,0,0</Thickness>
    <Thickness x:Key="XSmallLeftTopRightBottomMargin">8,8,8,8</Thickness>

    <Thickness x:Key="XXSmallTopMargin">0,4,0,0</Thickness>
    <Thickness x:Key="XXSmallLeftTopRightBottomMargin">4,4,4,4</Thickness>

    <Thickness x:Key="NavigationViewContentGridBorderThickness">0,1,0,0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,8,0,0</CornerRadius>
    <Thickness x:Key="NavigationViewContentMargin">0,44,0,0</Thickness>
    <Thickness x:Key="NavigationViewHeaderMargin">48,24,0,0</Thickness>
    <Thickness x:Key="NavigationViewPageContentMargin">48,20,48,0</Thickness>

    <Thickness x:Key="MenuBarContentMargin">32,24,32,0</Thickness>

    <Thickness x:Key="SettingsPageHyperlinkButtonMargin">-12,4,0,0</Thickness>

</ResourceDictionary>
