<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="LargeFontSize">24</x:Double>
    <x:Double x:Key="MediumFontSize">16</x:Double>

    <!-- Standard Windows 11 Typography Scale -->
    <x:Double x:Key="AppFontSizeTitle">28</x:Double>
    <x:Double x:Key="AppFontSizeSubtitle">18</x:Double>
    <x:Double x:Key="AppFontSizeBodyStrong">14</x:Double>
    <x:Double x:Key="AppFontSizeBody">14</x:Double>
    <x:Double x:Key="AppFontSizeCaption">12</x:Double>
    <x:Double x:Key="AppFontSizeReadout">12</x:Double>

</ResourceDictionary>
