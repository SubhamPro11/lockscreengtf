<Project>
  <PropertyGroup>
    <!-- Enforce the explicit code-style severities from .editorconfig in builds. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Unified branding & assembly metadata -->
    <Product>LockscreenGif</Product>
    <Authors>SubhamPro11</Authors>
    <Company>SubhamPro11</Company>
    <Copyright>© 2026 Subham Kumar (SubhamPro11).</Copyright>
    <PackageProjectUrl>https://lockscreen-gtf-web.morbius.workers.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SubhamPro11/lockscreengtf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version Condition="'$(Version)' == ''">4.26.11</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">4.26.11.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">4.26.11.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">4.26.11</InformationalVersion>
  </PropertyGroup>
</Project>
